// SPDX-License-Identifier: AGPL-3.0-only
//! STR bundle GUI 编辑器 —— 简约主窗口（可伸缩树 / 思维导图 / 内容与关联管理 / 深浅色）。

import {
    Button,
    CheckBox,
    LineEdit,
    TextEdit,
    ListView,
    ScrollView,
    VerticalBox,
    HorizontalBox,
    TabWidget,
    ComboBox,
} from "std-widgets.slint";

import { Palette } from "std-widgets.slint";
export { Palette }

// data-transfer 在 Slint 中不透明：经宿主语言回调编解码（"visit|path"）。
export global DndApi {
    pure callback entry-to-transfer(string) -> data-transfer;
    // 同源的**字符串**版载荷（拖拽开始时求整组并写进 DndApi.payload）：
    // entry-to-transfer 的返回类型是 data-transfer，赋不进 string 属性。
    pure callback payload-for(int, string) -> string;
    // 拖拽组是否**连续**（选区行在可视行序里中间不夹未选中行；单条拖拽 = true）。
    // 连续组凡与组相接的插入边界（组前 / 组内 / 组后紧邻）都是顺序不变的无效点，
    // 用于抑制插入指示线；非连续组任何落点都会让其余成员移动补位（全部放行）。
    // 拖拽开始时与 payload 一同求值（见行 DragArea 的 changed dragging）。
    pure callback src-contig-for(int, string) -> bool;
    // 拖拽组是否含未登记成员（见 src-mixed；与 drop_row 的 has_unregistered 同源）。
    pure callback src-mixed-for(int, string) -> bool;
    // ── 结构树分支拖拽（同级重排）──
    // 载荷 = branch-to-transfer(visit)（"branch|<visit>"，与条目载荷可辨）。
    in-out property <int> tree-src-visit: -1;
    in-out property <int> tree-hover-visit: -2;
    in-out property <int> tree-hover-half: 0;
    // 上半区 = 插入为子分支（整行高亮，与内容「移入文件夹」一致）；
    // 下半区 = 同级排序（行底插入线）。
    in-out property <bool> tree-hover-nest: false;
    pure callback branch-to-transfer(int) -> data-transfer;
    // 解析分支载荷：条目 / 外部文件载荷返回 -1。
    pure callback transfer-to-branch(data-transfer) -> int;
    // 上半区落点有效性：不能拖到自身 / 自身子树内（ROOT 不可拖动）。
    pure callback tree-nest-ok(int, int) -> bool;
    // 下半区落点有效性：同父同级且非「顺序不变」边界（拖到自身 / 紧邻原位）。
    pure callback tree-drop-ok(int, int, bool) -> bool;
    pure callback transfer-to-entry(data-transfer) -> string;
    // 外部文件拖入（OS 文件管理器）：判别与读取路径列表（\n 分隔）。
    pure callback transfer-has-files(data-transfer) -> bool;
    pure callback transfer-to-files(data-transfer) -> string;
    // 悬停落点（由各 DropArea 的 can-drop 写入，指示条从这里渲染，
    // 避免依赖 has-drag 在离开旧区域时残影）：
    // hover-row = 条目行号（-1 = 列表末尾，-2 = 无）；hover-half = 0 上半区 / 1 下半区；
    // hover-files = 外部文件悬停中。
    in-out property <int> hover-row: -2;
    in-out property <int> hover-half: 0;
    in-out property <bool> hover-files: false;
    // 拖拽源行号与其是否为顶层条目（用于拒绝"顺序不变"的无效落点）。
    in-out property <int> hover-src-row: -1;
    in-out property <bool> hover-src-top: false;
    // 拖拽组连续性（src-contig-for 的结果，随 hover-src-row 一同写入）。
    in-out property <bool> src-contig: true;
    // 拖拽组是否含**未登记**成员（内容文件夹子行等，无 order 语义）：此时
    // 「重排」不可表达，文件夹行上半区退化为移入该文件夹（指示同步切换为
    // 整行高亮），保证提示与实际落点一致。
    in-out property <bool> src-mixed: false;
    // 当前落点是否参与排序（显示插入线）：根条目总是可排序；
    // 子行只有拖到根层级的行之间才可排序（文件夹内不排序）。
    in-out property <bool> hover-sortable: false;
    // 当前拖拽是否为外部文件（用于末尾区文案与高亮语义区分）。
    in-out property <bool> hover-external: false;
    // 当前手势是否为"移入/导入到某个文件夹"（整行高亮）。
    in-out property <bool> hover-into-dir: false;
    // 悬停状态所属面板（src-visit）：面板有多个实例（每个导图节点一个），
    // 行高亮/指示线只允许归属面板响应，否则拖拽时所有节点的同行同时触发。
    in-out property <int> hover-panel: -2;
    // 悬停状态所属导图节点（visit）：拖拽悬停到某分支上时该节点高亮反馈。
    in-out property <int> hover-node: -2;
    // 被拖条目所属分支的 visits 下标（Rust 侧随选中分支更新；拖拽开始时面板写入自身值）。
    in-out property <int> src-visit: -1;
    // 内部条目拖拽的载荷（拖拽开始时写入，规避 data-transfer 文本往返问题）。
    in-out property <string> payload;
    // 条目拖拽进行中（行 DragArea 写入）：选中组内的其余行同步变暗，
    // 与被抓取行保持一致的「正在被拖」视觉（Finder 语义）。
    in-out property <bool> entry-drag-active: false;
    // ── 导图边缘自动滚动 ──
    // 光标在 mind 可视区内的坐标（由画布级 / 节点级 DropArea 的 can-drop 持续上报）。
    in-out property <length> mind-pos-x: -1px;
    in-out property <length> mind-pos-y: -1px;
    // 拖拽是否悬于导图区域（驱动边缘滚动定时器；离开导图区 / 拖放结束复位）。
    in-out property <bool> mind-drag: false;

    /// 拖拽会话收尾（落下成功 / 落在无效区域 / 取消）后的**唯一**清理点。
    ///
    /// 各调用处只管调用，**不要**再各自手抄字段清单 —— 早前 EntryApi.end-drop 与
    /// AppWindow.clear-dnd-hover 就是两份会漂移的副本，都漏了 `mind-drag`：
    /// 取消拖拽后画布边缘滚动停不下来（timer 的 running 就是它，且 `mind-pos-*`
    /// 停在边缘带内 → content-x 被持续写，画布自己缓慢平移）。
    ///
    /// `src-visit` 不在此清理：它的不变量是「等于当前激活分支」（Rust 侧维护），
    /// 拖拽期间被面板临时改写为拖拽源，收尾由 Rust 回调复位。
    public function reset() {
        clear-hover();
        // 拖拽源标记与载荷：仅在一次拖拽会话内有效。
        hover-src-row = -1;
        hover-src-top = false;
        src-contig = true;
        src-mixed = false;
        tree-src-visit = -1;
        tree-hover-visit = -2;
        tree-hover-half = 0;
        tree-hover-nest = false;
        hover-external = false;
        payload = "";
        entry-drag-active = false;
    }

    /// 清空「上一个悬停区域」留下的指示，并复位画布边缘滚动。
    ///
    /// 每个 DropArea 的 `can-drop` 都**先调用它、再置自己的字段** —— 这样「离开
    /// 上一个区域」不依赖对方记得清理。早前 8 个 can-drop 各写一份字段子集，彼此
    /// 漂移：画布空白处漏了 `hover-node`，于是拖拽从分支移到画布空白后，该分支的
    /// 激活高亮一直留着（另有几处漏 `mind-drag`，边缘滚动停不下来）。
    ///
    /// 注意**不含**会话级状态（`payload` / `hover-src-*`）：它们在区域之间切换时
    /// 必须保活（行级落点要用它判断「拖回原位」这类无效落点）。
    public function clear-hover() {
        hover-row = -2;
        hover-half = 0;
        hover-files = false;
        hover-sortable = false;
        hover-into-dir = false;
        hover-panel = -2;
        hover-node = -2;
        tree-hover-visit = -2;
        tree-hover-half = 0;
        tree-hover-nest = false;
        // 边缘滚动只在画布 / 节点区域内有效。
        mind-drag = false;
        mind-pos-x = -1px;
        mind-pos-y = -1px;
    }

}

// 内容条目交互回调：面板（列表视图 / 导图节点）与 Rust 处理器之间的统一入口。
// 面板交互一律先 activate-visit(src-visit) 确保分支选中，再调用具体动作 ——
// Rust 侧处理器因此无需感知面板归属，列表与导图节点得以完全复用同一套逻辑。
export global EntryApi {
    callback activate-visit(int);
    callback select-entry(int);
    callback clear-selection();
    callback toggle-dir(int);
    // 条目动作**不接收行号**：目标 = `menu-targets`（与右侧栏视图同步的
    // 「当前生效选区」解析结果，相对路径 \n 分隔，由 Rust 在每次选中状态
    // 变化时刷新）——彻底消除行号空间错位 / 右键时序导致的作用域漂移。
    callback entry-open();
    callback entry-reveal();
    callback entry-copy-path();
    callback entry-reveal-terminal();
    callback entry-rename-open();
    callback entry-copy();
    callback entry-cut();
    callback entry-duplicate();
    in-out property <string> menu-targets;
    // 右键目标所属分支（visits 下标）：右键会先激活所在节点，故此属性随
    // fill 刷新为激活分支；跨节点右键后动作作用于新激活分支的选中行。
    in-out property <int> menu-target-visit: -1;
    callback delete-entry();
    callback save-entry();
    callback new-folder();
    callback paste();
    // 粘贴到**内容文件夹**（文件夹行右键「粘贴」）：参数 = 文件夹相对路径。
    callback paste-into(string);
    // 在**内容文件夹**内新建文件夹（文件夹行右键）：参数 = 文件夹相对路径。
    callback new-folder-into(string);
    // 右键菜单「刷新」（条目行 / 面板空白）：重新扫描磁盘并同步 UI。
    callback refresh-request();
    // 落点处理：transfer / files / 行号(-1=末尾) / 是否移入文件夹 / 是否插到行后。
    callback drop-row(string, string, int, bool, bool);
    // ── 内容条目批量操作（Finder 语义：⌘/Ctrl 点击切换、Shift 点击范围、⌘A 全选）──
    // 多选对象是内容条目（payload / asset / dir），分支不参与；状态由 Rust 侧维护。
    // 参数：面板归属分支 visit（Rust 侧仅当其 == 当前选中分支时处理）、行下标、修饰键。
    // 注意不能用 pure：带副作用（改多选集合 + 重建 UI），pure 会被求值器缓存/折叠。
    // 条目行左键点击：修饰键决策在 Rust 侧（macOS 用 NSEvent 实时查询，
    // Slint 的 ctrl/shift 仅作非 macOS 平台的提示值）。
    callback entry-click(int, int, bool, bool);
    // 多选摘要（Rust 侧随选中状态刷新）：「已选中 n 个条目：名称…」。
    // 右侧栏在多选无主选中时显示该摘要，多选有主选中时作为编辑范围提示。
    in-out property <string> multi-summary: "";
    callback entries-select-all();
    callback entries-batch-rename();
    in-out property <int> multi-count: 0;
    /// 拖拽收尾：清理全局拖拽状态（唯一实现在 `DndApi.reset`），并要求 Rust 侧把
    /// `src-visit` 复位到当前激活分支（拖拽期间被面板改写为拖拽源）。
    public function end-drop() {
        DndApi.reset();
        EntryApi.drag-ended();
    }
    /// 拖拽收尾通知（Rust 侧复位 `src-visit`）。
    callback drag-ended();
}

export struct BranchRow {
    visit: int,
    title: string,
    // 行主文本（title）是否**全为拉丁**（不含 CJK / 假名 / 谚文 / 全角 / emoji 等
    // 「满高字形」）。由 Rust 侧建模型时算一次（main.rs `is_latin_only`），
    // UI 只读布尔值 ⇒ 渲染期零字符串开销。仅拉丁行需要 1px 光学下移补偿。
    latin: bool,
    type-str: string,
    depth: int,
    kind: string,
    is-selected: bool,
    expanded: bool,
    has-children: bool,
    // 是否含内容条目（`node`/`branch` 之外）：控制「展开 / 收起内容」菜单项可用性。
    has-entries: bool,
}

/// 批量操作汇总的一行：`status` = "✓" 成功 / "✗" 失败（汇总对话框逐行展示）。
export struct BatchResultRow {
    status: string,
    title: string,
    message: string,
}

export struct EntryRow {
    path: string,
    // 显示用名称：顶层条目 = path；文件夹子行 = 真实文件名（不带父路径前缀）。
    display: string,
    // 行主文本（display）是否全为拉丁 —— 同 BranchRow.latin，建模型时算一次。
    latin: bool,
    role: string,
    title: string,
    size: string,
    is-branch: bool,
    is-file: bool,
    depth: int,
    is-dir: bool,
    expanded: bool,
    // 多选（Finder 语义：⌘/Ctrl 点击切换、Shift 点击范围、⌘A 全选）标记。
    in-multi: bool,
}

export struct RefRow {
    ref-id: string,
    target: string,
    target-title: string,
    rel: string,
    title: string,
}

/// 「快捷键一览」的一行（内容表在 Rust 侧，修饰键字形按平台切换）：
/// `head` = 该分组的首行 —— 列表在这一行之前画组标题。
export struct Shortcut {
    head: bool,
    group: string,
    name: string,
    keys: string,
}

/// 连线段合并后的 Path 块（画布按列分块 / 小地图整图一块）：
/// `x/y/w/h` 是内容坐标系里的包络盒，`commands` 是 Path 命令串。
/// 画布块用 `fit: preserve`（命令串坐标已相对包络盒）—— 包络盒同时用于
/// 「屏幕外整块跳过」的裁剪判定；小地图块保留内容绝对坐标，用 viewbox 缩放到面板。
export struct MindEdgeChunk {
    x: float,
    y: float,
    w: float,
    h: float,
    commands: string,
}

/// 导图节点内的内容条目：直接携带完整 EntryRow 模型（与列表视图同一数据结构）。
export struct MindNode {
    visit: int,
    x: float,
    y: float,
    w: float,
    h: float,
    title: string,
    type-str: string,
    is-root: bool,
    is-selected: bool,
    // 内容展开态：true 时节点内嵌完整内容列表面板（与列表视图功能一致）。
    expanded: bool,
    // 子树是否展开（控制行首 ›/⌄ 箭头）。
    children-expanded: bool,
    has-children: bool,
    // 是否存在内容条目（无论展开与否，控制内容按钮可见性）。
    has-entries: bool,
    entry-rows: [EntryRow],
}

// 列表行首展开 / 收起箭头：矢量折线（原来是 9px 的 ▶/▼ 文本字形——字形随字体度量
// 浮动、笔画粗细不匀、字面还自带左右留白）。折叠 = 右向 ›、展开 = 下向 ⌄，
// **几何与导图 MindIconButton 完全相同**（10×10 viewbox、1.5px 描边、同一组命令），
// 全应用只此一种箭头样式。
// 宽度 = 箭头列本身（10px）：这个值是结构树 / 内容列表 `padding-left` 缩进步长的
// 组成部分，改它要同步改缩进（每级缩进 = 本列 + 行内间距 4px = 14px）。
// **叶子行也占同一列**（`expandable: false` 时只占位、不画折线）：Slint 的
// `visible: false` 仍占布局空间，同级「有箭头 / 无箭头」的行必须同宽，否则标题会错开。
component RowChevron inherits Rectangle {
    in property <bool> expanded;
    in property <bool> expandable;
    in property <color> fg;
    callback clicked;
    width: 10px;
    TouchArea {
        clicked => { if (parent.expandable) { parent.clicked(); } }
    }
    if expandable: Path {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        fill: transparent;
        stroke: parent.fg;
        stroke-width: 1.5px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: parent.expanded
            ? "M 1.5 3.5 L 5 7 L 8.5 3.5"
            : "M 3.5 1.5 L 7 5 L 3.5 8.5";
    }
}

// 内容条目四列视图：列表视图与导图节点共用（同列宽、同字体、同配色）。
// 字号统一 12px：Finder 列表的各列**同字号**，主/副之分只靠颜色（labelColor /
// secondaryLabelColor），不像我们原先副列小一号 —— 那是自造的层级，与 Finder 不符。
component EntryCols inherits HorizontalLayout {
    in property <string> display;
    in property <string> title;
    in property <string> role;
    in property <string> size;
    in property <color> main-color;
    in property <color> sub-color;
    spacing: 4px;
    Text {
        text: display;
        font-size: 12px;
        color: main-color;
        overflow: elide;
        vertical-alignment: center;
        width: 40%;
    }
    Text {
        text: title;
        font-size: 12px;
        color: sub-color;
        overflow: elide;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Text {
        text: role;
        font-size: 12px;
        color: sub-color;
        overflow: elide;
        vertical-alignment: center;
        width: 56px;
    }
    Text {
        text: size;
        font-size: 12px;
        color: sub-color;
        vertical-alignment: center;
        width: 60px;
        horizontal-alignment: right;
    }
}

// 导图节点图标按钮：圆角小方块 + 折线箭头标（随展开态变向，悬停高亮）。
// horizontal = 水平轴（子树：› 收起 / ‹ 展开）；垂直轴（内容：⌄ 收起 / ⌃ 展开）。
component MindIconButton inherits Rectangle {
    in property <bool> expanded;
    in property <bool> horizontal;
    in property <color> fg;
    in property <color> bg-hover;
    callback clicked;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: ta.has-hover ? bg-hover : transparent;
    ta := TouchArea {
        clicked => { parent.clicked(); }
    }
    Path {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        fill: transparent;
        stroke: parent.fg;
        stroke-width: 1.5px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: parent.horizontal
            // 子树伸缩：仅「展开且悬停」时显示左箭头（点击收起），其余为右箭头。
            ? (parent.expanded && ta.has-hover
                ? "M 6.5 1.5 L 3 5 L 6.5 8.5"
                : "M 3.5 1.5 L 7 5 L 3.5 8.5")
            : (parent.expanded
                ? "M 1.5 6.5 L 5 3 L 8.5 6.5"
                : "M 1.5 3.5 L 5 7 L 8.5 3.5");
    }
}

// 「关于」对话框的信息行：左标签右值（配色由调用处传入，组件外不可见 root 属性）。
component AboutRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> label-color;
    in property <color> value-color;
    spacing: 8px;
    Text {
        text: label;
        font-size: 12px;
        color: label-color;
        vertical-alignment: center;
        width: 96px;
    }
    Text {
        text: value;
        font-size: 12px;
        color: value-color;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

// 欢迎引导里的行内链接：宽度贴合文字（stretch 0），accent 色 + pointer 光标。
// 可与说明文字放在同一 HorizontalLayout 里，紧随其后不占整行。
component WelcomeLink inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    callback clicked;
    height: 22px;
    horizontal-stretch: 0;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        font-size: 12px;
        color: tint;
        vertical-alignment: center;
        // 非布局容器的子元素默认居中 —— 显式贴左 + 固有宽度，保证始终左对齐。
        x: 0;
        width: self.preferred-width;
    }
}

// 「快捷键一览」的一行：左名称（超长省略）、右按键（底纹胶囊）。
component ShortcutRow inherits HorizontalLayout {
    in property <string> name;
    in property <string> keys;
    in property <color> name-color;
    in property <color> keys-color;
    in property <color> keys-bg;
    spacing: 12px;
    height: 22px;
    Text {
        text: name;
        font-size: 13px;
        color: name-color;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    Rectangle {
        background: keys-bg;
        border-radius: 4px;
        height: 20px;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: keys;
                font-size: 11px;
                color: keys-color;
                vertical-alignment: center;
            }
        }
    }
}

// 内容条目列表面板：列表视图（中栏）与导图节点内容区完全复用 ——
// 选中 / 文件夹展开 / 右键菜单 / 拖拽重排 / 外部文件导入 / 末尾放置区，功能与样式一致。
// 约定：所有交互先 EntryApi.activate-visit(src-visit) 确保该分支为当前选中分支，
// 再调用既有动作回调，Rust 侧处理器无需感知面板归属。
component EntryListPanel inherits Rectangle {
    in property <int> src-visit: -1;
    in property <[EntryRow]> entries;
    in property <int> selected-index: -1;
    in property <color> col-text;
    in property <color> col-sub;
    in property <color> col-sel;
    in property <color> col-row-bg;
    in property <color> col-on-sel;
    // 拖拽中的行底（见 `c-drag-bg`）。
    in property <color> col-drag-bg;
    // 面板空白处被点击（语义由调用方决定：清内容选区 / 取消分支激活）。
    callback blank-clicked();
    in property <color> col-badge;
    in property <color> col-accent;
    // 整组拖拽：被抓行属于多选选区（与 Rust 侧 payload 展开同一判据）。
    // 单条拖拽（被抓行不在选区内）为 false —— 此时插入无效点的抑制只看被抓行
    // 自身（mem-* 里的 `== hover-src-row` 分支），不会波及无关的选中块。
    property <bool> group-drag: DndApi.hover-src-row >= 0
        && entries[Math.max(DndApi.hover-src-row, 0)].in-multi;
    clip: true;

    // 底层：分支级菜单（仅手动 show，避免自动触发）。
    blankmenu := ContextMenuArea {
        Menu {
            MenuItem {
                title: "新建文件夹";
                activated => {
                    EntryApi.activate-visit(src-visit);
                    EntryApi.new-folder();
                }
            }
            MenuItem {
                title: "粘贴";
                activated => {
                    EntryApi.activate-visit(src-visit);
                    EntryApi.paste();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "刷新";
                activated => {
                    EntryApi.refresh-request();
                }
            }
        }
    }
    // 空白处点击（TouchArea 消费所有按键，因此右键也在这里处理：取消选中 + 手动弹
    // 分支菜单）。语义交给调用方：列表视图 = 只清内容选区（当前分支仍是激活分支）；
    // 导图节点内嵌面板 = 取消分支激活（与画布空白一致）。
    TouchArea {
        clicked => { root.blank-clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right
                && event.kind == PointerEventKind.up) {
                // 右键不改变任何状态，直接弹菜单（激活延迟到菜单项点击）。
                blankmenu.show({x: self.mouse-x, y: self.mouse-y});
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    VerticalLayout {
        spacing: 0px;
        if entries.length == 0: Rectangle {
            Text {
                text: "（此分支暂无内容条目——可从 Finder 拖入文件）";
                font-size: 12px;
                color: col-sub;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
        if entries.length > 0: ListView {
            // 节点内嵌时容器高度固定：禁止 ListView 隐式最小高度把末尾放置区推出裁剪区。
            min-height: 0px;
            vertical-stretch: 1;
            for entry[index] in entries: Rectangle {
                // 行高对标 Finder 列表视图（本机实测 40px @2x = 20pt；与 Rust 侧
                // ENTRY_ROW_H 一致，导图节点高度按它计算）。
                height: 20px;
                property <bool> hover-top: DndApi.hover-panel == src-visit
                    && DndApi.hover-row == index
                    && DndApi.hover-half == 0;
                property <bool> hover-bottom: DndApi.hover-panel == src-visit
                    && DndApi.hover-row == index
                    && DndApi.hover-half == 1;
                // 文件夹行：内部拖到下半区 / 外部文件落到其上 = 移入（整行高亮）。
                property <bool> hover-folder: entry.is-dir
                    && DndApi.hover-panel == src-visit
                    && DndApi.hover-into-dir && DndApi.hover-row == index;
                // 插入点渲染约定：插到"行后"一律画在下一行的顶边
                // （最后一行除外，画在该行行底）。这样光标在同一插入点
                // 附近上下移动时，指示线位置稳定不跳。
                // 指示线只用于根路径条目排序；文件夹子行拖拽不显示。
                property <bool> insert-before: DndApi.hover-panel == src-visit
                    && DndApi.hover-sortable
                    && (hover-top
                        || (index > 0 && DndApi.hover-row == index - 1
                            && DndApi.hover-half == 1
                            && entries[index - 1].depth == 0));
                property <bool> insert-after: DndApi.hover-panel == src-visit
                    && DndApi.hover-sortable
                    && hover-bottom && !entry.is-dir
                    && index == entries.length - 1;
                // 拖动中（Finder 语义）：被抓取行 + 同面板选区成员整组「正在被搬走」。
                property <bool> is-dragging: dragarea.dragging
                    || (DndApi.entry-drag-active && DndApi.src-visit == src-visit
                        && entry.in-multi);
                // 落点边界两侧是否属于「被拖的组」：单条拖拽 = 仅被抓行自身；
                // 整组拖拽 = 全部选区行。配合 src-contig：连续组凡与组相接的边界
                // 都是顺序不变的无效点；非连续组仅拼接段内部（两侧都是选区行）无效。
                property <bool> mem-self: index == DndApi.hover-src-row
                    || (group-drag && entry.in-multi);
                property <bool> mem-prev: index > 0
                    && (index - 1 == DndApi.hover-src-row
                        || (group-drag && entries[Math.max(index - 1, 0)].in-multi));
                property <bool> mem-next: index < entries.length - 1
                    && (index + 1 == DndApi.hover-src-row
                        || (group-drag
                            && entries[Math.min(index + 1, entries.length - 1)].in-multi));
                // 落点参数以**全局悬停状态**为准：行上叠加了三层 DropArea
                // （topzone / bottomzone / filedrop），实测 Slint 的 dropped 可能
                // 落在 filedrop（最上层）而非 can-drop 接受的那层——此前 filedrop
                // 传 `entry.is-dir`，文件夹行上方明明显示插入线却落进了文件夹。
                // 悬停状态由 can-drop 写入、与指示符完全同源 ⇒ 落点与指示必然一致。
                // hover-panel != src-visit（跨面板边缘情形）时退化为行本地值。
                property <bool> drop-live: DndApi.hover-panel == src-visit;
                property <int> drop-row-idx: drop-live && DndApi.hover-row >= 0
                    ? DndApi.hover-row
                    : index;
                property <bool> drop-into: drop-live
                    ? DndApi.hover-into-dir
                    : entry.is-dir;
                property <bool> drop-after: drop-live && DndApi.hover-half == 1;
                // 单选与多选**同一高亮**：主选中与选区成员同一色块。
                // 拖拽中不算选中 ⇒ 文字 / 箭头自动回到普通色，底色由 is-dragging 单独画；
                // 但**拼接段**（连续选区合并成一整块）在拖拽中必须保持 —— is-block 就是
                // 「这块要画成整段」的判定，圆角与段内分隔线都看它。
                property <bool> is-sel: (selected-index == index || entry.in-multi)
                    && !is-dragging;
                property <bool> is-block: is-sel || is-dragging;
                // 连续选中段（Finder 语义：多选高亮合并成一整块）——
                // 判断上下相邻行是否也选中，只给整段的首行圆上角、末行圆下角，
                // 段内直角，于是相邻行拼成一整块而无内部圆角/缝隙。
                // 数组按下标取值先 Math.max/min 夹紧，避免越界（不依赖 && 短路）。
                property <bool> sel-prev: index > 0
                    && (selected-index == index - 1
                        || entries[Math.max(index - 1, 0)].in-multi);
                property <bool> sel-next: index < entries.length - 1
                    && (selected-index == index + 1
                        || entries[Math.min(index + 1, entries.length - 1)].in-multi);
                // 行底：Finder 式圆角内缩色块（左右各内缩 4px、铺满行高无行间缝、
                // 圆角 6px），与结构树同形状。选中段 = 实心 accent（段内合并），
                // 未选中行交替底色（偶数行留白 / 奇数行浅灰）。
                // 必须最先声明：沉在行内容与各命中层之下。
                Rectangle {
                    x: 4px;
                    width: parent.width - 8px;
                    height: parent.height;
                    border-top-left-radius: is-block && sel-prev ? 0px : 6px;
                    border-top-right-radius: is-block && sel-prev ? 0px : 6px;
                    border-bottom-left-radius: is-block && sel-next ? 0px : 6px;
                    border-bottom-right-radius: is-block && sel-next ? 0px : 6px;
                    background: is-dragging ? col-drag-bg
                        : is-sel ? col-sel
                        : hover-folder ? col-badge
                        : (Math.mod(index, 2) == 0 ? transparent : col-row-bg);
                }
                // 合并段内部的分隔线：Finder 实测 —— 选中色混 **10% 白**、1px 高
                // （底色 rgb(0,107,218) → 线 rgb(25,121,222)，三通道反解混白比例一致）。
                // 只画在段内相邻两行的交界处：段首 sel-prev 为 false 不画，段尾由下一行画。
                // 注意 Slint `mix(other, f)` 的 f 是 **self 的权重**（源码 lerp(self, other, f)），
                // 所以「混 10% 白」要写 0.9。
                Rectangle {
                    visible: is-block && sel-prev;
                    x: 4px;
                    y: 0;
                    width: parent.width - 8px;
                    height: 1px;
                    // 拖拽中块底是浅灰，分隔线用「块色混 8% 黑」的下沉沟槽
                    // （白色过亮突兀）；选中蓝时沿用混白 10%。
                    background: is-dragging
                        ? col-drag-bg.mix(#000000, 0.92)
                        : col-sel.mix(#ffffff, 0.9);
                }
                Rectangle {
                    y: 0;
                    height: 3px;
                    width: 100%;
                    background: col-accent;
                    visible: insert-before;
                }
                Rectangle {
                    y: parent.height - 3px;
                    height: 3px;
                    width: 100%;
                    background: col-accent;
                    visible: insert-after;
                }
                // 层级（先声明在底层）：ctxmenu（手动 show）→ rowdrop → dragarea{内容+TouchArea}。
                // 右键菜单（原生样式，对标 Finder）；TouchArea 消费右键后手动 show()。
                ctxmenu := ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "打开";
                            activated => {
                                EntryApi.entry-open();
                            }
                        }
                        MenuItem {
                            title: "在 Finder 中显示";
                            activated => {
                                EntryApi.entry-reveal();
                            }
                        }
                        MenuItem {
                            title: "拷贝路径";
                            activated => {
                                EntryApi.entry-copy-path();
                            }
                        }
                        MenuItem {
                            title: "在终端中显示";
                            activated => {
                                EntryApi.entry-reveal-terminal();
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: "重命名…";
                            enabled: entry.role != "node" && entry.role != "branch";
                            activated => {
                                EntryApi.entry-rename-open();
                            }
                        }
                        MenuItem {
                            title: "拷贝";
                            enabled: entry.role != "node" && entry.role != "branch";
                            activated => {
                                EntryApi.entry-copy();
                            }
                        }
                        MenuItem {
                            title: "剪切";
                            enabled: entry.role != "node" && entry.role != "branch";
                            activated => {
                                EntryApi.entry-cut();
                            }
                        }
                        MenuItem {
                            title: "制作副本";
                            enabled: entry.role != "node" && entry.role != "branch";
                            activated => {
                                EntryApi.entry-duplicate();
                            }
                        }
                        // 文件夹行：在**该文件夹内部**新建文件夹 / 粘贴（Finder 语义）。
                        if entry.is-dir: MenuItem {
                            title: "新建文件夹";
                            activated => {
                                EntryApi.activate-visit(src-visit);
                                EntryApi.new-folder-into(entry.path);
                            }
                        }
                        if entry.is-dir: MenuItem {
                            title: "粘贴";
                            activated => {
                                EntryApi.activate-visit(src-visit);
                                EntryApi.paste-into(entry.path);
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: "移到废纸篓";
                            activated => {
                                // 不可 select-entry：右键弹出前 pointer-event 已按
                                // Finder 语义处理选区（落在选区内→保留整组，否则单选）；
                                // 这里再单选会把整组选区清成 1 条，导致只删 1 个。
                                EntryApi.activate-visit(src-visit);
                                EntryApi.delete-entry();
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: "刷新";
                            activated => {
                                EntryApi.refresh-request();
                            }
                        }
                    }
                }
                // 上半区：内部条目拖到 = 插到该行之前。
                topzone := DropArea {
                    y: 0;
                    height: 12px;
                    can-drop(event) => {
                        // 先清空上一个区域的悬停指示，再置本区域状态（规则见 DndApi.clear-hover）。
                        DndApi.clear-hover();
                        // 命中面板行级落点：精确放置（clear-hover 已暂停导图边缘滚动）。
                        // 顶层源：顺序不变的无效落点直接拒绝 —— 连续组 = 凡与被拖组
                        // 相接的边界（自身行 / 组前 / 组内 / 组后紧邻）；非连续组 =
                        // 拼接段内部（两侧都是选区行，首项前后照常可插入）。
                        // 该抑制只对拖拽源面板本身生效（src-visit 相同）——
                        // 跨节点拖放时源行号属于另一面板，不能套用。
                        if (DndApi.transfer-to-entry(event.data) != ""
                            && !(DndApi.src-visit == src-visit && DndApi.hover-src-top
                                && entry.depth == 0
                                && (DndApi.src-contig
                                    ? (mem-self || mem-prev)
                                    : (mem-self && mem-prev)))) {
                            DndApi.hover-row = index;
                            DndApi.hover-half = 0;
                            DndApi.hover-files = false;
                            DndApi.hover-external = false;
                            // 上半区 = 插到该行之前；唯一例外是含未登记成员的整组
                            // 拖到文件夹行上（重排不可表达 ⇒ 退化为移入，指示用整行
                            // 高亮而非插入线，见 src-mixed）。
                            DndApi.hover-into-dir = entry.is-dir && DndApi.src-mixed;
                            DndApi.hover-sortable = entry.depth == 0
                                && !(entry.is-dir && DndApi.src-mixed);
                            DndApi.hover-panel = src-visit;
                            DndApi.hover-node = src-visit;
                            DragAction.move
                        } else if (DndApi.transfer-has-files(event.data)) {
                            // 外部文件：文件夹行 = 导入其内部（Rust 端 dir 行一律落入
                            // drop_dir，指示必须一致 ⇒ 上半区也显示整行高亮而非插入线）；
                            // 文件行 = 插入位（可排序）。
                            DndApi.hover-row = index;
                            DndApi.hover-half = 0;
                            DndApi.hover-files = true;
                            DndApi.hover-external = true;
                            DndApi.hover-into-dir = entry.is-dir;
                            DndApi.hover-sortable = entry.depth == 0
                                && !entry.is-dir;
                            DndApi.hover-panel = src-visit;
                            DndApi.hover-node = src-visit;
                            DragAction.copy
                        } else {
                            DndApi.hover-row = -2;
                            DndApi.hover-files = false;
                            DndApi.hover-into-dir = false;
                            DndApi.hover-panel = -2;
                            DndApi.hover-node = -2;
                            DragAction.none
                        }
                    }
                    dropped(event) => {
                        EntryApi.activate-visit(src-visit);
                        // 落点参数取全局悬停状态（与指示符同源），见 drop-* 属性注释。
                        EntryApi.drop-row(
                            DndApi.transfer-to-entry(event.data),
                            DndApi.transfer-to-files(event.data),
                            drop-row-idx,
                            drop-into,
                            drop-after);
                        EntryApi.end-drop();
                        return event.proposed-action;
                    }
                }
                // 下半区：文件行 = 插到该行之后；文件夹行 = 移入文件夹。
                bottomzone := DropArea {
                    y: 12px;
                    height: 12px;
                    can-drop(event) => {
                        // 先清空上一个区域的悬停指示，再置本区域状态（规则见 DndApi.clear-hover）。
                        DndApi.clear-hover();
                        // 命中面板行级落点：精确放置（clear-hover 已暂停导图边缘滚动）。
                        // "上一行的下半区"是重排的无序位；但文件夹行下半区
                        // = 移入文件夹（与源位置无关，始终有效），不能拒绝
                        //（仅被抓文件夹行自身的下半区仍按无效点拒绝）。
                        // 无效点判定与上半区同规则：连续组 = 与被拖组相接的边界；
                        // 非连续组 = 拼接段内部。抑制只对拖拽源面板本身生效。
                        if (DndApi.transfer-to-entry(event.data) != ""
                            && !(DndApi.src-visit == src-visit && DndApi.hover-src-top
                                && entry.depth == 0
                                && (entry.is-dir
                                    ? index == DndApi.hover-src-row
                                    : (DndApi.src-contig
                                        ? (mem-self || mem-next)
                                        : (mem-self && mem-next))))) {
                            DndApi.hover-row = index;
                            DndApi.hover-half = 1;
                            DndApi.hover-files = false;
                            DndApi.hover-external = false;
                            DndApi.hover-into-dir = entry.is-dir;
                            DndApi.hover-sortable = entry.depth == 0
                                && !entry.is-dir;
                            DndApi.hover-panel = src-visit;
                            DndApi.hover-node = src-visit;
                            DragAction.move
                        } else if (DndApi.transfer-has-files(event.data)) {
                            // 外部文件：文件夹行 = 导入其内部；根层级行 = 插入位。
                            DndApi.hover-row = index;
                            DndApi.hover-half = 1;
                            DndApi.hover-files = true;
                            DndApi.hover-external = true;
                            DndApi.hover-into-dir = entry.is-dir;
                            DndApi.hover-sortable = entry.depth == 0
                                && !entry.is-dir;
                            DndApi.hover-panel = src-visit;
                            DndApi.hover-node = src-visit;
                            DragAction.copy
                        } else {
                            DndApi.hover-row = -2;
                            DndApi.hover-files = false;
                            DndApi.hover-into-dir = false;
                            DndApi.hover-panel = -2;
                            DndApi.hover-node = -2;
                            DragAction.none
                        }
                    }
                    dropped(event) => {
                        EntryApi.activate-visit(src-visit);
                        // 落点参数取全局悬停状态（与指示符同源），见 drop-* 属性注释。
                        EntryApi.drop-row(
                            DndApi.transfer-to-entry(event.data),
                            DndApi.transfer-to-files(event.data),
                            drop-row-idx,
                            drop-into,
                            drop-after);
                        EntryApi.end-drop();
                        return event.proposed-action;
                    }
                }
                // 整行外部文件拖入：文件夹行 = 移入文件夹；文件行 = 导入分支。
                filedrop := DropArea {
                    can-drop(event) => {
                        // 整行区域只作为 Drop 的接收层：语义由上半区/下半区写入的
                        // 全局悬停状态决定，这里一律不接受，避免抢写状态。
                        DndApi.mind-drag = false;
                        DragAction.none
                    }
                    dropped(event) => {
                        EntryApi.activate-visit(src-visit);
                        // 落点参数取全局悬停状态（与指示符同源），见 drop-* 属性注释。
                        EntryApi.drop-row(
                            DndApi.transfer-to-entry(event.data),
                            DndApi.transfer-to-files(event.data),
                            drop-row-idx,
                            drop-into,
                            drop-after);
                        EntryApi.end-drop();
                        return event.proposed-action;
                    }
                }
                // 整行可拖拽；TouchArea 在内容层之下（后声明者在上），
                // 展开箭头的点击才能落在自己的 TouchArea 上。
                dragarea := DragArea {
                    data: DndApi.entry-to-transfer("\{src-visit}|\{entry.path}");
                    allow-copy: true;
                    allow-move: true;
                    changed dragging => {
                        if (self.dragging) {
                            DndApi.src-visit = src-visit;
                            DndApi.entry-drag-active = true;
                            // **在拖拽开始这一刻**求整组载荷（同步调 payload-for，读到的
                            // 正是此刻的选区）。行的 `data` 绑定只在重渲染时求值，抓「选中组
                            // 里的一行」时它常是选中之前的陈旧单条值 ⇒ 批量移动只动一个。
                            // 落点以本字段为准（见 on_drop_row 的注释）。
                            DndApi.payload = DndApi.payload-for(src-visit, entry.path);
                            DndApi.hover-src-row = index;
                            DndApi.hover-src-top = entry.depth == 0;
                            // 选区连续性同样以拖拽开始这一刻为准（与 payload 同源）。
                            DndApi.src-contig = DndApi.src-contig-for(src-visit, entry.path);
                            DndApi.src-mixed = DndApi.src-mixed-for(src-visit, entry.path);
                        } else {
                            DndApi.entry-drag-active = false;
                        }
                    }
                    // 拖拽结束（落下 / 落在无效区域 / 取消）→ 统一收尾。
                    // 这里**不能**手写字段清单：早前就是漏了 mind-drag，取消拖拽后
                    // 画布边缘滚动停不下来（见 EntryApi.end-drop 的注释）。
                    drag-finished(action) => {
                        EntryApi.end-drop();
                    }
                    TouchArea {
                        // 选择逻辑**全部**收敛到 pointer-event（左键抬起）：
                        // Slint 的 clicked 先于 pointer-event(Up) 触发（vendored
                        // input_items.rs），若把普通选中放 clicked、多选放
                        // pointer-event，clicked 里的「清空多选 + 重置锚点」会把
                        // Shift 范围选择的锚点摧毁（范围塌缩成单行）。这里统一
                        // 分发：无修饰键 = 单选；⌘(Ctrl) = 切换；Shift = 范围。
                        double-clicked => {
                            EntryApi.activate-visit(src-visit);
                            if (entry.is-dir) {
                                EntryApi.toggle-dir(index);
                            } else {
                                EntryApi.entry-open();
                            }
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right
                                && event.kind == PointerEventKind.up) {
                                // 右键 = 激活所在节点 + 选中该行（Finder 语义）：
                                // 先激活（跨节点时切换分支并重建行模型——与结构树
                                // 右键同模式，此刻菜单尚未弹出，重建安全），再选中，
                                // 菜单动作经 menu-targets 精确作用于该行。
                                EntryApi.activate-visit(src-visit);
                                if (!entry.in-multi) {
                                    EntryApi.select-entry(index);
                                }
                                ctxmenu.show({x: self.mouse-x, y: self.mouse-y});
                                return EventResult.accept;
                            }
                            if (event.button == PointerEventButton.left
                                && event.kind == PointerEventKind.up) {
                                // 修饰键决策统一收敛到 Rust 侧（entry-click）：
                                // macOS 上 Slint 的键盘事件跟踪不可靠，由 NSEvent
                                // 实时查询兜底；这里的 modifiers 只作非 macOS 提示值。
                                EntryApi.entry-click(src-visit, index,
                                    event.modifiers.control || event.modifiers.meta,
                                    event.modifiers.shift);
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                    }
                    HorizontalLayout {
                        // 行内容相对**整行**居中（铺满行高）；**仅全拉丁行**下移 1px 做
                        // 光学居中：Text 按行盒居中，而字体把下伸部也算进行盒，拉丁字母
                        // 墨迹只占 cap 高度 ⇒ 不补偿会偏高（实测 12px 字体：上 12 / 下 18）。
                        // 满高字形（CJK 等）墨迹本就接近行盒中心，下移反而偏低，故不补偿。
                        // latin 由 Rust 建模型时算好，这里只读布尔值。
                        y: entry.latin ? 1.5px : 0px;
                        height: 100%;
                        // 每级缩进 = 箭头列 10px + 行内间距 4px：子级箭头正好落在
                        // 父级标题的起始位置，形成「一级一个箭头列」的规整阶梯。
                        // 基础 8px = 行底色块的 4px 内缩 + 箭头自身的 4px 留白
                        // —— 箭头必须落在色块内部，故比色块内缩再多 4px。
                        padding-left: 8px + entry.depth * 14px;
                        padding-right: 10px;
                        // 箭头左右留白求对称（相对色块左缘）：左 = 4px(块内留白) +
                        // 2.75px(折线自身笔画余量)，右 = 2.25px(同上) + 4px(本间距)。
                        spacing: 4px;
                        // 文件夹展开/收缩箭头（列宽见 RowChevron）；文件行只占位。
                        RowChevron {
                            expandable: entry.is-dir;
                            expanded: entry.expanded;
                            fg: is-sel ? col-on-sel : col-sub;
                            clicked => {
                                EntryApi.activate-visit(src-visit);
                                EntryApi.toggle-dir(index);
                            }
                        }
                        EntryCols {
                            display: entry.display;
                            title: entry.title;
                            role: entry.role;
                            size: entry.size;
                            // 选中行色块为实心 accent：主列转纯白，副列转**白 70%**
                            // —— Finder 选中行实测：主文本 rgb(255,255,255)、
                            // 副文本 = 白在选中蓝上以 70% 合成（rgb(179,211,244)，三通道
                            // 反解 α 一致 = 0.70），不是纯白。
                            main-color: is-sel ? col-on-sel : col-text;
                            sub-color: is-sel ? col-on-sel.transparentize(0.3) : col-sub;
                        }
                    }
                }
            }
        }
        // 列表底部放置区 = 移到末尾。
        Rectangle {
            height: 16px;
            property <bool> end-hover: DndApi.hover-panel == src-visit
                && DndApi.hover-row == -1;
            Text {
                width: 100%;
                height: 100%;
                text: DndApi.hover-external
                    ? (end-hover ? "松开导入到分支" : "拖到此处导入到分支")
                    : (end-hover
                        ? (DndApi.hover-src-top ? "松开移到末尾" : "松开移回根目录")
                        : (DndApi.hover-src-top ? "拖到此处移到末尾" : "拖到此处移回根目录"));
                font-size: 10px;
                color: end-hover ? col-accent : col-sub;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                y: 0;
                height: 3px;
                width: 100%;
                background: col-accent;
                visible: end-hover;
            }
            enddrop := DropArea {
                can-drop(event) => {
                    // 先清空上一个区域的悬停指示，再置本区域状态（规则见 DndApi.clear-hover）。
                    DndApi.clear-hover();
                    if ((DndApi.transfer-to-entry(event.data) != ""
                        || DndApi.transfer-has-files(event.data))
                        && !(DndApi.src-visit == src-visit && DndApi.hover-src-top
                            && DndApi.src-contig
                            && (DndApi.hover-src-row == entries.length - 1
                                || (group-drag
                                    && entries[Math.max(entries.length - 1, 0)].in-multi)))) {
                        DndApi.hover-row = -1;
                        DndApi.hover-files = false;
                        DndApi.hover-panel = src-visit;
                        DndApi.hover-node = src-visit;
                        DndApi.hover-external = DndApi.transfer-has-files(event.data);
                        if (DndApi.hover-external) {
                            DragAction.copy
                        } else {
                            DragAction.move
                        }
                    } else {
                        DndApi.hover-row = -2;
                        DndApi.hover-files = false;
                        DndApi.hover-panel = -2;
                        DndApi.hover-node = -2;
                        DragAction.none
                    }
                }
                dropped(event) => {
                    EntryApi.activate-visit(src-visit);
                    EntryApi.drop-row(
                        DndApi.transfer-to-entry(event.data),
                        DndApi.transfer-to-files(event.data),
                        -1,
                        false,
                        true);
                    EntryApi.end-drop();
                    return event.proposed-action;
                }
            }
        }
    }
}

export struct MindEdge {
    x: float,
    y: float,
    w: float,
    h: float,
}

export component AppWindow inherits Window {
    title: "STR 编辑器";
    preferred-width: 1180px;
    preferred-height: 740px;
    min-width: 920px;
    min-height: 580px;
    background: c-window;

    // 主题：三态选择 → 生效态 → ①写 Slint 内置 Palette（Widget 主题）②通报宿主上报 OS
    init => {
        root.apply-appearance();
    }
    changed dark-mode => {
        root.apply-appearance();
    }

    // ── 主题 ──
    // 0 = 跟随系统，1 = 浅色，2 = 深色
    in-out property <int> appearance-mode: 0;
    // 系统当前是否为深色：Rust 启动时向 OS 查询后写入（非 macOS 恒 false）
    in-out property <bool> system-dark: false;
    // 生效的深色态：显式深色，或「跟随系统」且系统当前为深色
    in property <bool> dark-mode: root.appearance-mode == 2
        || (root.appearance-mode == 0 && root.system-dark);

    function apply-appearance() {
        // Widget 侧配色（含菜单弹出层）由进程级 ColorScheme 驱动：Rust 端通过
        // Window::set_color_scheme 把它设为「跟随系统的真实值 / 浅色 / 深色」，
        // 从而让 FluentPalette 不再依赖后端时序、菜单背景稳定。
        // 这里仍显式写 Palette.color-scheme 作为兜底（StyleMetrics.dark-color-scheme 读它），
        // 真正的确定性来源在 Rust 侧。
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.report-app-appearance(root.appearance-mode);
    }
    in property <color> c-window: root.dark-mode ? #1b1d22 : #f5f6f8;
    in property <color> c-panel: root.dark-mode ? #24262c : #ffffff;
    in property <color> c-text: root.dark-mode ? #e5e7eb : #1f2937;
    // 副文本色对标 Finder 的 `secondaryLabelColor`：浅色 = 黑 50%（白底实测
    // rgb(128,128,128)），深色 = 白 55%（≈ 与面板底色混合后的中性灰）。
    in property <color> c-sub: root.dark-mode ? #909090 : #808080;
    in property <color> c-line: root.dark-mode ? #33363d : #e5e7eb;
    in property <color> c-sel: root.dark-mode ? #1e3a5f : #e4edff;
    in property <color> c-sel-text: root.dark-mode ? #7ab3ff : #1d4ed8;
    in property <color> c-hover: root.dark-mode ? #2a2d34 : #fafbfc;
    in property <color> c-badge-bg: root.dark-mode ? #31356f : #eef2ff;
    in property <color> c-badge-text: root.dark-mode ? #a5b4fc : #4f46e5;
    in property <color> c-status-bg: root.dark-mode ? #26282e : #eceef1;
    in property <color> c-accent: root.dark-mode ? #4f7cff : #1d4ed8;
    // 行底令牌（结构树 / 内容列表共用同一套「Finder 式行」）：未选中行统一浅灰
    // 圆角色块；选中行用 c-accent 实心填充，其上的文字与箭头一律 c-on-accent。
    in property <color> c-row-bg: root.dark-mode ? #2a2d34 : #f4f5f5;
    // 拖拽中的行底（Finder 语义）：被抓取条目 + 同组选区成员整组「正在被搬走」，
    // 只把底色调成**非常浅**的中性灰（结构与文字样式都不变，仅换色）。
    in property <color> c-drag-bg: root.dark-mode ? #43464f : #e7e8ea;
    // 选中行填充色 = macOS `NSColor.selectedContentBackgroundColor` 实测值
    // （Finder 列表的选中行就是它）：light #0064E1 / dark #0059D1。
    // 与 c-accent 分开：c-accent 还用于描边/指示线/链接（深色下需要更亮）。
    in property <color> c-row-sel: root.dark-mode ? #0059d1 : #0064e1;
    in property <color> c-on-accent: #ffffff;

    // ── 状态 ──
    in property <string> bundle-name: "未打开 bundle";
    in property <bool> has-bundle: false;
    in property <[BranchRow]> rows;
    in property <bool> view-mind: false;

    // ── 详情（信息页）──
    in-out property <string> d-title;
    in-out property <string> d-type;
    in-out property <string> d-summary;
    in-out property <string> d-tags;
    in property <string> d-kind: "—";
    in property <string> d-id: "";
    in property <string> d-revision: "";
    in property <string> d-updated: "";
    in property <bool> has-selection: false;
    in property <bool> is-root: false;

    // ── 新建子分支 ──
    in-out property <string> child-title;
    in-out property <string> child-type;

    // ── 内容 entries[] ──
    in property <[EntryRow]> entries;
    in property <int> entry-selected: -1;
    in property <bool> entry-editable: false;
    // 右侧栏信息标签页：0=分支(结构信息)，1=条目(内容信息)。默认 0。
    in-out property <int> info-tab: 0;
    in-out property <string> e-title;
    in-out property <string> e-note;
    in-out property <string> e-order;
    in property <string> e-kind: "—";
    in property <string> e-path: "";
    in-out property <string> a-path;
    in-out property <int> a-role-index: 0;

    // ── 关联 refs[]（暂时隐藏该功能，属性保留以备后续启用）──
    in property <[RefRow]> refs;
    in-out property <string> r-target;
    in-out property <string> r-rel;
    in-out property <string> r-title;

    // ── 思维导图 ──
    // 无限画布：内容画在超大画布中央，四周留白可自由平移（Flickable 边界几乎不可达）。
    property <length> mind-canvas-w: max(4000px, root.mind-w * 2 * 1px);
    property <length> mind-canvas-h: max(3000px, root.mind-h * 2 * 1px);
    // 内容在画布中的居中偏移。
    property <length> mind-off-x: (mind-canvas-w - root.mind-w * 1px) / 2;
    property <length> mind-off-y: (mind-canvas-h - root.mind-h * 1px) / 2;
    in property <[MindNode]> mind-nodes;
    in property <int> mind-node-count: 0;
    // 画布 / 小地图连线（分块 Path，见 MindEdgeChunk）。
    in property <[MindEdgeChunk]> mind-edge-chunks;
    in property <[MindEdgeChunk]> mind-mini-edge-chunks;
    // 小地图有两种形态，映射真源都在这里（Rust 侧烘焙密度位图时回读同一组数值，
    // 避免「面板里画的位置」与「位图里的位置」两处公式漂移）：
    //   块状（内容还能分辨出单个节点）：等比缩放，面板随内容长宽比自适应；
    //   密度（超大导图）：两轴独立缩放把内容铺满固定面板，由 Rust 侧烘焙位图。
    out property <float> mini-mm-scale: min(
        184.0 / max(root.mind-w - root.mind-edge-offset, 1.0),
        116.0 / max(root.mind-h, 1.0));
    // 密度形态判据：节点块在缩略图里不足 2px（个体无法分辨、画出来只会堆叠），
    // 或节点数过多（逐项绘制的每帧开销不再划算）。2px 对应 NODE_H(28px) × 比例。
    out property <bool> mini-dense: 28.0 * root.mini-mm-scale < 2.0
        || root.mind-node-count > 1200;
    out property <float> mini-sx: root.mini-dense
        ? 184.0 / max(root.mind-w - root.mind-edge-offset, 1.0)
        : root.mini-mm-scale;
    out property <float> mini-sy: root.mini-dense
        ? 116.0 / max(root.mind-h, 1.0)
        : root.mini-mm-scale;
    // 缩略图内容盒（面板 = 盒 + 8px 内边距 ×2）。
    out property <length> mini-box-w: root.mini-dense
        ? 184px
        : clamp((root.mind-w - root.mind-edge-offset) * root.mini-mm-scale * 1px, 124px, 204px);
    out property <length> mini-box-h: root.mini-dense
        ? 116px
        : clamp(root.mind-h * root.mini-mm-scale * 1px, 74px, 124px);
    // 密度位图（Rust 侧烘焙，仅密度形态有值）与其用色（同样由这里回读）。
    in property <image> mind-mini-image;
    out property <color> mini-ink: c-sub;
    out property <color> mini-accent: c-accent;
    // 视口裁剪的外扩边距：节点矩形被裁掉的只是「完全离屏」者，边距用于吸收
    // 外置子树按钮、内容面板圆角等溢出节点矩形的部分（400px 远大于其尺寸，
    // 且不影响滚动时的观感）。
    property <length> mind-cull-margin: 400px;
    // 节点标题行高（与 Rust NODE_H 的标题行一致）。既是布局高度，也是节点手势的
    // 命中高度 —— 两者必须同源，否则「点标题行 = 选中该节点」的判定会和视觉错位。
    property <length> node-title-h: 28px;
    // 子树按钮的横向占位（值由 Rust 侧 SUBTREE_BTN_EXTENT 提供）：
    // 缩略图内容宽度需据此扣除，否则右侧多一段空白、左右留白不对称。
    in property <float> mind-edge-offset: 0.0;
    in property <float> mind-w: 600;
    in property <float> mind-h: 400;
    // 画布缩放（鼠标滚轮，光标为锚点；档位 0.5~3）。
    in-out property <float> mind-zoom: 1.0;
    // 菜单/快捷键缩放的来源标记：置位后由 flick 内的 changed mind-zoom
    // 以「视口中心」为锚点重算视口并夹取。滚轮路径自行按光标锚点计算，
    // 不使用该标记（避免两种锚点互相覆盖）。
    property <bool> zoom-anchor: false;
    // 缩放档位跳变（与滚轮 zoom-at 同一组档位；对齐档位避免矢量字亚像素柔化）。
    function zoom-next(dir: int) -> float {
        let z = root.mind-zoom;
        return dir > 0
            ? (z < 0.5 ? 0.5 : z < 0.75 ? 0.75 : z < 1.0 ? 1.0 : z < 1.25 ? 1.25
                : z < 1.5 ? 1.5 : z < 2.0 ? 2.0 : 3.0)
            : (z > 3.0 ? 3.0 : z > 2.0 ? 2.0 : z > 1.5 ? 1.5 : z > 1.25 ? 1.25
                : z > 1.0 ? 1.0 : z > 0.75 ? 0.75 : 0.5);
    }
    // 档位未变化时不置标记：否则 changed 不触发，标记会残留并污染后续滚轮缩放。
    function zoom-by(dir: int) {
        let target = root.zoom-next(dir);
        if (target != root.mind-zoom) {
            root.zoom-anchor = true;
            root.mind-zoom = target;
        }
    }
    function zoom-reset() {
        if (root.mind-zoom != 1.0) {
            root.zoom-anchor = true;
            root.mind-zoom = 1.0;
        }
    }
    // 画布视口（content-x/y 的双向镜像）：居中逻辑见 center-canvas 回调。
    in-out property <length> mind-vpx;
    in-out property <length> mind-vpy;
    // 居中画布视口（参数 = 视口尺寸，逻辑 px；由 flick 布局变化时触发）。
    callback center-canvas(float, float);

    // ── 拖拽：被拖条目所属分支的 visits 下标（Rust 侧随选中分支更新）──
    // ── 对话框 ──
    in property <bool> dialog-visible: false;
    in-out property <string> new-name;
    in property <string> new-dir: "";
    in property <bool> dir-picked: false;

    // ── 重命名对话框（条目：改磁盘文件 / 目录名）──
    in property <bool> rename-visible: false;
    in-out property <string> rename-name;

    // ── 重命名分支对话框（只改显示名 `._meta.title`）──
    in property <bool> branch-rename-visible: false;
    in-out property <string> branch-rename-name;

    // ── 新建子分支对话框（结构树右键）──
    in property <bool> branch-dialog-visible: false;
    in-out property <string> bc-title;
    in-out property <string> bc-type;

    // ── 帮助 → 快捷键一览（内容表在 Rust 侧，见 shortcut_table）──
    in-out property <bool> shortcuts-visible: false;
    in property <[Shortcut]> shortcuts;
    // 帮助菜单的在线入口：0 = 格式规范、1 = 仓库主页、2 = 问题反馈。
    callback open-doc(int);

    // ── 状态栏 ──
    in property <string> status: "打开或新建一个 .str bundle 开始编辑。";

    // ── 菜单栏「分支」项的可用性（由 Rust 随选中态维护）──
    in property <bool> sel-has-children: false;
    in property <bool> sel-has-entries: false;
    // ── 「展开全部 / 收起全部」的可用性（由 Rust 维护）──
    // 子树侧看全树；内容侧只看**当前可见（已展开）的分支** —— 与展开动作同口径。
    in property <bool> any-has-children: false;
    in property <bool> any-visible-has-entries: false;

    // ── 关于对话框 ──
    // macOS 由 Rust 侧置 true：原生应用菜单自带「关于」（信息经 Slint 补丁注入），
    // 帮助菜单不再重复出现；其余平台保留 帮助 → 关于。
    in property <bool> is-macos: false;
    in-out property <bool> about-visible: false;
    // 静态信息（Rust 侧启动时写入，编译期常量）
    in property <string> about-app-version: "";
    in property <string> about-lib-version: "";
    in property <string> about-spec-version: "";
    in property <string> about-str-major: "";
    in property <string> about-repository: "";
    in property <string> about-license: "";

    // 编辑菜单可用性：需选中条目，且无模态对话框——否则对话框内的文本编辑
    // 会被菜单快捷键（⌘C/⌘V 等）截获，无法正常复制粘贴文字。
    // 有主选中**或**存在多选区（⌘A / ⌘ 点击后主选中可能为空，但选区非空，
    // 复制 / 剪切 / 删除都应作用于整个选区）。
    property <bool> entry-cmd-ok: (root.entry-selected >= 0 || EntryApi.multi-count > 0)
        && !root.dialog-visible
        && !root.rename-visible
        && !root.branch-dialog-visible;

    callback open-bundle();
    callback new-bundle();
    callback refresh();

    // ── 最近打开的 bundle（文件菜单 + 欢迎引导弹窗共用；Rust 维护与持久化）──
    in property <[string]> recent-files;
    callback open-recent(string);
    callback clear-recent();

    callback run-validate();
    // 把用户的外观选择（0 跟随系统 / 1 浅色 / 2 深色）通报给宿主，由 Rust 侧上报 OS：
    // macOS 上 0 表示把 NSApp 的 appearance 置空（交还系统），1/2 则显式指定。
    callback report-app-appearance(int);
    callback set-view(bool);
    callback row-click(int);
    callback toggle-expand(int);
    callback select-visit(int);
    // 点击导图空白处：取消分支选中（激活）状态。
    callback clear-activation();
    // 导图：双击节点伸缩子树；▶ 展开/收起节点内内容条目。
    callback toggle-visit-expand(int);
    callback toggle-node-content(int);
    // 菜单栏「分支」：同上两个开关，作用于**当前选中分支**（菜单项没有行下标 / visit，
    // 由宿主按选中态解析目标）。
    callback toggle-sel-subtree();
    callback toggle-sel-content();
    // 菜单栏「视图」：展开 / 收起**全部**（纯视图状态，不写盘）。
    callback expand-all-subtrees();
    callback collapse-all-subtrees();
    callback expand-all-contents();
    callback collapse-all-contents();
    // 分支重命名（只改 `._meta.title`；目录名是 UUID，不参与重命名）。
    callback branch-rename-open();
    callback branch-rename-confirm();
    callback branch-rename-cancel();
    callback save-details();
    callback add-child();
    callback delete-branch();
    callback add-entry();
    callback entry-drop-to-branch(string, string, int);
    // 分支拖拽重排：src_visit 拖到 target_visit 的前/后（同级分支之间）。
    callback drop-branch-row(int, int, bool);
    callback external-files-dropped(string);
    callback reveal-branch();
    callback branch-copy-path();
    callback branch-reveal-terminal();
    callback child-dialog-open();
    callback child-dialog-create();
    callback child-dialog-cancel();
    callback rename-confirm();
    callback rename-cancel();
    callback add-ref();
    callback delete-ref(int);
    callback dialog-browse();
    callback dialog-create();
    callback dialog-cancel();

    // ── 内容条目批量操作状态（进度 / 汇总 / 批量重命名对话框）──
    // 多选集合与计数在 EntryApi（条目域）；这里的属性是批量执行的执行态。
    in-out property <bool> batch-busy: false;
    in-out property <int> progress-done: 0;
    in-out property <int> progress-total: 0;
    in-out property <string> progress-text: "";
    in-out property <bool> summary-visible: false;
    in-out property <string> summary-title: "";
    in-out property <bool> summary-has-failed: false;
    in property <[BatchResultRow]> summary-rows;
    callback summary-retry();
    callback summary-close();
    // 批量完成（后台线程经 invoke 触发）：主线程重扫磁盘并刷新多选状态。
    callback batch-finished();
    in-out property <bool> br-visible: false;
    in-out property <int> br-mode: 0;
    in-out property <string> br-find;
    in-out property <string> br-replace;
    in-out property <string> br-prefix;
    in-out property <string> br-suffix;
    callback br-apply();
    callback br-cancel();

    // ── 整窗外部文件拖放兜底：导入当前选中分支 ──
    // 先声明 → 位于最底层：树/条目的 DropArea（更晚声明、在上层）优先命中；
    // 只有落点不在任何具体 DropArea 上时才轮到这里。
    MenuBar {
        Menu {
            title: "文件";
            MenuItem { title: "打开文件…"; shortcut: @keys(Control + O); activated => { root.open-bundle(); } }
            MenuItem { title: "新建文件…"; shortcut: @keys(Control + N); activated => { root.new-bundle(); } }
            // 最近打开：子菜单内逐条直达（由 Rust 维护模型并持久化到用户配置目录）。
            if root.recent-files.length > 0: Menu {
                title: "打开最近";
                for r in root.recent-files: MenuItem {
                    title: r;
                    activated => { root.open-recent(r); }
                }
                MenuItem {
                    title: "清除最近列表";
                    activated => { root.clear-recent(); }
                }
            }
            MenuSeparator { }
            // 刷新 = 重新扫描磁盘并重建模型（数据层面的「重新载入」），故归「文件」；
            // 校验是应用级动作，见「工具」。
            MenuItem {
                title: "刷新（重新扫描磁盘）";
                shortcut: @keys(Control + R);
                enabled: root.has-bundle;
                activated => { root.refresh(); }
            }
        }
        // 编辑：统一作用于「当前激活分支内选中的内容条目」（entry-selected），
        // 与内容面板右键菜单同一批回调；未选中条目时相应项置灰。
        Menu {
            title: "编辑";
            MenuItem {
                // Finder 语义：⌘A 全选作用于当前内容列表（多选入口之一）。
                title: "全选";
                shortcut: @keys(Control + A);
                enabled: root.has-bundle;
                activated => { EntryApi.entries-select-all(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "拷贝";
                shortcut: @keys(Control + C);
                enabled: root.entry-cmd-ok;
                activated => { EntryApi.entry-copy(); }
            }
            MenuItem {
                title: "剪切";
                shortcut: @keys(Control + X);
                enabled: root.entry-cmd-ok;
                activated => { EntryApi.entry-cut(); }
            }
            MenuItem {
                title: "粘贴";
                shortcut: @keys(Control + V);
                enabled: root.has-bundle;
                activated => { EntryApi.paste(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "制作副本";
                shortcut: @keys(Control + D);
                enabled: root.entry-cmd-ok;
                activated => { EntryApi.entry-duplicate(); }
            }
            MenuItem {
                // 条目重命名 = 改磁盘文件名 / 目录名（与「分支 → 重命名分支…」
                // 只改 `._meta.title` 不同），标题里写明作用对象以免混淆。
                title: "重命名条目…";
                enabled: root.entry-cmd-ok;
                activated => { EntryApi.entry-rename-open(); }
            }
            MenuItem {
                title: "删除";
                shortcut: @keys(Control + Delete);
                enabled: root.entry-cmd-ok;
                activated => { EntryApi.delete-entry(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "新建文件夹";
                enabled: root.has-bundle;
                activated => { EntryApi.new-folder(); }
            }
            MenuItem {
                title: "保存条目修改";
                shortcut: @keys(Control + S);
                enabled: root.entry-cmd-ok;
                activated => { EntryApi.save-entry(); }
            }
        }
        // 分支：作用于**当前选中分支**（与结构树 / 导图节点右键菜单同一批回调，
        // 保证两处行为一致）；无选中或功能不适用时置灰。
        Menu {
            title: "分支";
            MenuItem {
                title: "新建子分支…";
                shortcut: @keys(Control + Shift + N);
                enabled: root.has-selection;
                activated => { root.child-dialog-open(); }
            }
            MenuItem {
                title: "保存分支信息";
                shortcut: @keys(Control + Shift + S);
                enabled: root.has-selection;
                activated => { root.save-details(); }
            }
            MenuItem {
                title: "重命名分支…";
                enabled: root.has-selection;
                activated => { root.branch-rename-open(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "展开 / 收起子树";
                enabled: root.has-selection && root.sel-has-children;
                activated => { root.toggle-sel-subtree(); }
            }
            MenuItem {
                title: "展开 / 收起内容";
                // 内容内嵌面板只存在于导图节点 → 列表视图下无效，随之禁用。
                enabled: root.has-selection && root.sel-has-entries && root.view-mind;
                activated => { root.toggle-sel-content(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "粘贴";
                enabled: root.has-selection;
                activated => { EntryApi.paste(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "删除分支";
                shortcut: @keys(Control + Shift + Delete);
                enabled: root.has-selection && !root.is-root;
                activated => { root.delete-branch(); }
            }
        }
        // 工具：定位（分支 / 内容两类）与应用级校验。
        Menu {
            title: "工具";
            MenuItem {
                title: "在 Finder 中显示分支";
                shortcut: @keys(Control + Shift + R);
                enabled: root.has-selection;
                activated => { root.reveal-branch(); }
            }
            MenuItem {
                title: "在 Finder 中显示内容";
                shortcut: @keys(Control + Alt + R);
                enabled: root.entry-selected >= 0;
                activated => { EntryApi.entry-reveal(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "校验 bundle";
                shortcut: @keys(Control + Shift + V);
                enabled: root.has-bundle;
                activated => { root.run-validate(); }
            }
        }
        Menu {
            title: "视图";
            MenuItem {
                title: root.view-mind ? "　列表视图" : "✓ 列表视图";
                shortcut: @keys(Control + Digit1);
                enabled: root.has-bundle;
                activated => { root.set-view(false); }
            }
            MenuItem {
                title: root.view-mind ? "✓ 导图视图" : "　导图视图";
                shortcut: @keys(Control + Digit2);
                enabled: root.has-bundle;
                activated => { root.set-view(true); }
            }
            MenuSeparator { }
            // 画布缩放：仅在导图视图可用（列表视图没有画布），档位与滚轮一致。
            MenuItem {
                title: "放大";
                shortcut: @keys(Control + Plus);
                enabled: root.view-mind;
                activated => { root.zoom-by(1); }
            }
            MenuItem {
                title: "缩小";
                shortcut: @keys(Control + HyphenMinus);
                enabled: root.view-mind;
                activated => { root.zoom-by(-1); }
            }
            MenuItem {
                title: "实际大小";
                shortcut: @keys(Control + Digit0);
                enabled: root.view-mind;
                activated => { root.zoom-reset(); }
            }
            MenuSeparator { }
            // 全局展开/收起：纯视图状态（不写盘），与右键菜单里的「展开 / 收起
            // 子树 / 内容」同一批语义，只是作用范围为整棵树。
            MenuItem {
                title: "展开全部子树";
                enabled: root.has-bundle && root.any-has-children;
                activated => { root.expand-all-subtrees(); }
            }
            MenuItem {
                title: "收起全部子树";
                enabled: root.has-bundle && root.any-has-children;
                activated => { root.collapse-all-subtrees(); }
            }
            MenuItem {
                // 作用范围是「当前渲染出来的节点」（见 Rust 侧 visible_branch_ids），
                // 不再在标题里加注解 —— 文案保持与其他三项一致。
                // 内容面板只存在于导图节点里 → 列表视图下整体禁用。
                title: "展开全部内容";
                enabled: root.has-bundle && root.view-mind && root.any-visible-has-entries;
                activated => { root.expand-all-contents(); }
            }
            MenuItem {
                title: "收起全部内容";
                enabled: root.has-bundle && root.view-mind && root.any-visible-has-entries;
                activated => { root.collapse-all-contents(); }
            }
        }
        Menu {
            title: "外观";
            MenuItem {
                title: root.appearance-mode == 0 ? "✓ 跟随系统" : "　跟随系统";
                activated => { root.appearance-mode = 0; }
            }
            MenuItem {
                title: root.appearance-mode == 1 ? "✓ 浅色模式" : "　浅色模式";
                activated => { root.appearance-mode = 1; }
            }
            MenuItem {
                title: root.appearance-mode == 2 ? "✓ 深色模式" : "　深色模式";
                activated => { root.appearance-mode = 2; }
            }
        }
        // 帮助：本地内容（快捷键一览）+ 在线入口（规范 / 仓库 / 反馈）；
        // macOS 的「关于」由系统应用菜单承担，故本菜单在 macOS 上不含「关于」项。
        Menu {
            title: "帮助";
            MenuItem {
                title: "快捷键一览…";
                activated => { root.shortcuts-visible = true; }
            }
            MenuSeparator { }
            MenuItem { title: "打开格式规范（在线）"; activated => { root.open-doc(0); } }
            MenuItem { title: "打开仓库主页"; activated => { root.open-doc(1); } }
            MenuItem { title: "报告问题 / 反馈"; activated => { root.open-doc(2); } }
            if !root.is-macos: MenuSeparator { }
            if !root.is-macos: MenuItem {
                title: "关于 STR 编辑器…";
                activated => { root.about-visible = true; }
            }
        }
    }

    DropArea {
        can-drop(event) => {
            // 光标在列表空白处：清空所有悬停指示（行 / 节点 / 边缘滚动，见 DndApi.clear-hover）。
            DndApi.clear-hover();
            DndApi.transfer-to-entry(event.data) == "" && DndApi.transfer-has-files(event.data)
                ? DragAction.copy : DragAction.none;
        }
        dropped(event) => {
            root.external-files-dropped(DndApi.transfer-to-files(event.data));
            EntryApi.end-drop();
            return event.proposed-action;
        }
    }

    VerticalBox {
        padding: 14px;
        spacing: 10px;

        // ── 主区域 ──
        HorizontalBox {
            spacing: 12px;
            vertical-stretch: 1;

            // 左：结构列表（仅列表视图）
            if !root.view-mind: Rectangle {
                width: 320px;
                background: c-panel;
                border-radius: 10px;
                // 裁剪放在内层直角容器：带圆角的 clip 在渲染器里要走离屏层（每帧建 FBO +
                // 合成整棵子树），直角裁剪只是 scissor。内容自带 10px 内边距（= 圆角半径），
                // 行背景不会越出圆角，观感不变。
                Rectangle {
                    clip: true;


                    if !root.view-mind: VerticalBox {
                        padding: 10px;
                        spacing: 8px;
                        Text {
                            text: "结构";
                            font-size: 13px;
                            font-weight: 700;
                            color: c-text;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for row[index] in root.rows: Rectangle {
                                // 行高与内容列表同基准（对标 Finder 列表实测 20pt）。
                                height: 20px;
                                // 重排悬停（下半区）：只显示行底插入线，**不**亮整行
                                //（与内容列表排序手势一致——高亮 = 移入语义专属）。
                                property <bool> tree-reorder-hover: DndApi.tree-hover-visit == row.visit
                                    && DndApi.tree-hover-half == 1
                                    && !DndApi.tree-hover-nest;
                                // 整行高亮 = 「移入」语义专属（上半区嵌套 / 条目与外部
                                // 文件拖入）；重排悬停时必须熄灭，否则排序落点看着像移入。
                                property <bool> drag-hover: (treetop.has-drag || treebottom.has-drag)
                                    && !tree-reorder-hover;
                                property <bool> tree-line-bottom: tree-reorder-hover;
                                // 行底：Finder 式圆角内缩色块（与内容列表同形状/同尺寸）。
                                // 铺满行高 ⇒ 行上下相接无缝隙；未选中行交替底色
                                // （偶数行留白 / 奇数行 c-row-bg 浅灰），与 Finder 列表一致。
                                // 必须最先声明：沉在行内容与各命中层之下。
                                Rectangle {
                                    x: 4px;
                                    width: parent.width - 8px;
                                    height: parent.height;
                                    border-radius: 6px;
                                    background: drag-hover ? c-badge-bg
                                        : (row.is-selected ? c-row-sel
                                            : (Math.mod(index, 2) == 0
                                                ? transparent : c-row-bg));
                                }
                                Rectangle {
                                    x: 4px;
                                    y: parent.height - 3px;
                                    width: parent.width - 8px;
                                    height: 3px;
                                    background: c-accent;
                                    visible: tree-line-bottom;
                                }
                                // 行级 TouchArea 必须先声明，否则会盖住展开箭头的点击区。
                                // 分支级右键菜单：TouchArea 消费右键后手动 show()。
                                // 分支右键菜单：与菜单栏「分支」同一批操作（右键即选中，
                                // 见下方 TouchArea 的 pointer-event），仅额外保留两项
                                // 依赖行下标的子树开关。
                                treectx := ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: "新建子分支…";
                                            activated => { root.child-dialog-open(); }
                                        }
                                        MenuItem {
                                            title: "重命名分支…";
                                            activated => { root.branch-rename-open(); }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: "展开 / 收起子树";
                                            enabled: row.has-children;
                                            activated => { root.toggle-expand(index); }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: "在 Finder 中显示";
                                            activated => { root.reveal-branch(); }
                                        }
                                        MenuItem {
                                            title: "拷贝路径";
                                            activated => { root.branch-copy-path(); }
                                        }
                                        MenuItem {
                                            title: "在终端中显示";
                                            activated => { root.branch-reveal-terminal(); }
                                        }
                                        MenuItem {
                                            title: "粘贴";
                                            activated => { EntryApi.paste(); }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: "删除分支";
                                            enabled: row.kind != "root";
                                            activated => { root.delete-branch(); }
                                        }
                                    }
                                }
                                // 整行可拖拽（分支同级重排）；TouchArea 包在其中，
                                // 点击 / 双击 / 右键语义不变（同内容列表 dragarea 模式）。
                                branchdrag := DragArea {
                                    data: DndApi.branch-to-transfer(row.visit);
                                    allow-move: true;
                                    changed dragging => {
                                        DndApi.tree-src-visit = self.dragging ? row.visit : -1;
                                    }
                                    drag-finished(action) => { EntryApi.end-drop(); }
                                    TouchArea {
                                        clicked => { root.row-click(index); }
                                        double-clicked => { root.toggle-expand(index); }
                                        // 右键即选中（Finder 语义）+ 在光标处弹菜单。
                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.right
                                                && event.kind == PointerEventKind.up) {
                                                root.select-visit(row.visit);
                                                treectx.show({x: self.mouse-x, y: self.mouse-y});
                                                // 必须接受事件：否则冒泡到 ContextMenuArea 会重复弹菜单，
                                                // 两层菜单叠加导致菜单项点击失效。
                                                return EventResult.accept;
                                            }
                                            return EventResult.reject;
                                        }
                                    }
                                }
                                // 上半区：分支拖拽 = 插到该分支之前；条目 / 外部文件 = 移入该分支。
                                treetop := DropArea {
                                    y: 0;
                                    height: 50%;
                                    can-drop(event) => {
                                        // 光标在树上：清空所有悬停指示（行 / 节点 / 边缘滚动，见 DndApi.clear-hover）。
                                        DndApi.clear-hover();
                                        if (DndApi.transfer-to-branch(event.data) >= 0) {
                                            // 分支拖拽上半区 = 插入为该分支的**子分支**（可跨父级
                                            // 结构移动）：指示 = 整行高亮（同内容「移入文件夹」）。
                                            if (DndApi.tree-nest-ok(DndApi.tree-src-visit, row.visit)) {
                                                DndApi.tree-hover-visit = row.visit;
                                                DndApi.tree-hover-nest = true;
                                                DragAction.move
                                            } else {
                                                DndApi.tree-hover-visit = -2;
                                                DndApi.tree-hover-nest = false;
                                                DragAction.none
                                            }
                                        } else if (DndApi.transfer-to-entry(event.data) != ""
                                            || DndApi.transfer-has-files(event.data)) {
                                            DragAction.move
                                        } else {
                                            DragAction.none
                                        }
                                    }
                                    dropped(event) => {
                                        if (DndApi.transfer-to-branch(event.data) >= 0) {
                                            // 落点参数取全局悬停状态（与指示符同源，同内容列表 drop-*）。
                                            root.drop-branch-row(
                                                DndApi.tree-src-visit,
                                                DndApi.tree-hover-visit >= 0
                                                    ? DndApi.tree-hover-visit : row.visit,
                                                DndApi.tree-hover-nest);
                                        } else {
                                            root.entry-drop-to-branch(
                                                DndApi.transfer-to-entry(event.data),
                                                DndApi.transfer-to-files(event.data),
                                                row.visit);
                                        }
                                        EntryApi.end-drop();
                                        return event.proposed-action;
                                    }
                                }
                                // 下半区：分支拖拽 = 同级排序（插到该分支之后）；条目 / 外部文件 = 移入该分支。
                                treebottom := DropArea {
                                    y: parent.height / 2;
                                    height: parent.height / 2;
                                    can-drop(event) => {
                                        DndApi.clear-hover();
                                        if (DndApi.transfer-to-branch(event.data) >= 0) {
                                            // 分支拖拽下半区 = 同级排序（插到该分支之后）。
                                            if (DndApi.tree-drop-ok(DndApi.tree-src-visit, row.visit, true)) {
                                                DndApi.tree-hover-visit = row.visit;
                                                DndApi.tree-hover-half = 1;
                                                DndApi.tree-hover-nest = false;
                                                DragAction.move
                                            } else {
                                                DndApi.tree-hover-visit = -2;
                                                DndApi.tree-hover-nest = false;
                                                DragAction.none
                                            }
                                        } else if (DndApi.transfer-to-entry(event.data) != ""
                                            || DndApi.transfer-has-files(event.data)) {
                                            DragAction.move
                                        } else {
                                            DragAction.none
                                        }
                                    }
                                    dropped(event) => {
                                        if (DndApi.transfer-to-branch(event.data) >= 0) {
                                            root.drop-branch-row(
                                                DndApi.tree-src-visit,
                                                DndApi.tree-hover-visit >= 0
                                                    ? DndApi.tree-hover-visit : row.visit,
                                                DndApi.tree-hover-nest);
                                        } else {
                                            root.entry-drop-to-branch(
                                                DndApi.transfer-to-entry(event.data),
                                                DndApi.transfer-to-files(event.data),
                                                row.visit);
                                        }
                                        EntryApi.end-drop();
                                        return event.proposed-action;
                                    }
                                }
                                HorizontalLayout {
                                    // 行内容相对**整行**居中（铺满行高）；**仅全拉丁行**下移
                                    // 1px 做光学居中（同内容列表：满高字形不需要补偿）。
                                    // latin 由 Rust 建模型时算好，这里只读布尔值。
                                    y: row.latin ? 1.5px : 0px;
                                    height: 100%;
                                    // 每级缩进 = 箭头列 10px + 行内间距 4px：子级箭头
                                    // 与父级标题起始位置对齐。基础 8px = 色块内缩 4px +
                                    // 箭头自身留白 4px —— 箭头必须落在色块内部。
                                    padding-left: 8px + row.depth * 14px;
                                    padding-right: 10px;
                                    // 同内容列表：箭头左右留白（相对色块左缘）对称。
                                    spacing: 4px;
                                    RowChevron {
                                        expandable: row.has-children;
                                        expanded: row.expanded;
                                        fg: row.is-selected ? c-on-accent : c-sub;
                                        clicked => { root.toggle-expand(index); }
                                    }
                                    Text {
                                        text: row.title;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        font-weight: row.is-selected ? 600 : 400;
                                        color: row.is-selected ? c-on-accent : c-text;
                                        horizontal-stretch: 0;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: row.type-str;
                                        vertical-alignment: center;
                                        // 与标题同字号（Finder 各列同字号，只以颜色分层）；
                                        // 选中时副列是**白 70%**，不是纯白（同内容列表）。
                                        color: row.is-selected
                                            ? c-on-accent.transparentize(0.3) : c-sub;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                }
            }

            // 导图视图：导图占满主区域，仅保留右侧信息栏（隐藏结构列表与内容区）。
            if root.view-mind: Rectangle {
                horizontal-stretch: 1;
                background: c-panel;
                border-radius: 10px;

                // 内层容器：Slint 不允许布局与绝对定位元素混排，Flickable 包在内层。
                // 裁剪放在这一层（直角）而非外层圆角面板上：带圆角的 clip 在渲染器里
                // 要走离屏层（每帧建 FBO + 合成整棵子树），直角裁剪只是 scissor。
                // 圆角观感由外层背景提供，而画布内容离面板四角很远，不会被看出差别。
                Rectangle {
                    clip: true;
                    flick := Flickable {
                        vertical-stretch: 1;
                        // 内容像素尺寸随缩放变化（canvas 容器被 scale-factor 缩放）。
                        content-width: max(root.mind-canvas-w * root.mind-zoom, self.width);
                        content-height: max(root.mind-canvas-h * root.mind-zoom, self.height);
                        // 视口位置由 Rust 端在内容尺寸变化时居中；用户平移经双向绑定回传。
                        content-x <=> root.mind-vpx;
                        content-y <=> root.mind-vpy;

                        // 内容尺寸变化（展开/收缩节点）会使居中偏移 mind-off 漂移，
                        // 内容在画布坐标系里整体平移——补偿视口偏移，保持视口中心
                        // 对准的内容点不动（用户平移位置不丢失）。缩放已计入像素换算。
                        //
                        // 监听的是 mind-off 本身（经 off-watch 代理，Slint 的 changed 只能
                        // 监听本元素属性），**不能**改挂 flick 的 content-width：画布尺寸
                        // 有 max(4000px, …) 下限，中小导图下内容变了而 content-width 不变，
                        // 补偿就漏触发（展开时整图横跳 Δoff×zoom，实测 67px）；反过来它又会
                        // 在缩放时误触发——把陈旧的 off 差值算进去，与 zoom-anchor 的锚点
                        // 补偿叠加成随机跳动。off 与缩放无关，故 off-watch 只在真正的居中
                        // 偏移变化时触发，两条路径互不干扰。
                        property <length> last-off-x;
                        property <length> last-off-y;
                        property <length> off-watch-x: root.mind-off-x;
                        property <length> off-watch-y: root.mind-off-y;

                        // 以画布坐标 (px, py) 为锚点切换到目标缩放值。
                        // 屏幕位置 = c*zoom + content-x；保持光标处内容点
                        // 不动 → content-x' = content-x - c*(zoom' - zoom)。
                        function apply-zoom(target: float, px: length, py: length) {
                            if (target == root.mind-zoom) {
                                return;
                            }
                            let dx = px * (root.mind-zoom - target);
                            let dy = py * (root.mind-zoom - target);
                            root.mind-zoom = target;
                            // 先更新缩放再 clamp（范围绑定随 zoom 重算），
                            // 防止锚点在空白处缩放时把内容推出视野。
                            flick.content-x = clamp(
                                flick.content-x + dx,
                                flick.sc-min-x,
                                flick.sc-max-x);
                            flick.content-y = clamp(
                                flick.content-y + dy,
                                flick.sc-min-y,
                                flick.sc-max-y);
                        }

                        // 滚轮缩放：按档位跳变（0.5/0.75/1/1.25/1.5/2/3）。
                        // 档位对齐避免任意比例缩放时矢量字形的亚像素柔化。
                        function zoom-at(px: length, py: length, delta: length) {
                            let z = root.mind-zoom;
                            let target = delta < 0px
                                ? (z < 0.5 ? 0.5
                                    : z < 0.75 ? 0.75
                                    : z < 1.0 ? 1.0
                                    : z < 1.25 ? 1.25
                                    : z < 1.5 ? 1.5
                                    : z < 2.0 ? 2.0
                                    : 3.0)
                                : (z > 3.0 ? 3.0
                                    : z > 2.0 ? 2.0
                                    : z > 1.5 ? 1.5
                                    : z > 1.25 ? 1.25
                                    : z > 1.0 ? 1.0
                                    : z > 0.75 ? 0.75
                                    : 0.5);
                            apply-zoom(target, px, py);
                        }
                        // 视口范围（像素坐标）：保证视口中心可停在内容包围盒内任意点——
                        // 视口中心 c = -content-x + vp/2 ∈ [中心z - H, 中心z + H]，
                        // H = max(内容跨度×zoom, vp) / 2（中心z = (off + w/2) * zoom）。
                        // 旧实现固定 H = vp/2：内容远大于视口时视口中心被锁在内容中心
                        // 附近（平移范围恒等于视口宽），导图内容过多时无法拖到边缘；
                        // 内容小于视口时 H = vp/2，退化为旧行为（中心 ± 半视口）。
                        // 滚轮缩放与边缘滚动共用，任何操作后视口始终与内容相交。
                        property <length> sc-min-x:
                            -((root.mind-off-x + root.mind-w * 1px / 2) * root.mind-zoom)
                                + (self.width
                                    - max(root.mind-w * 1px * root.mind-zoom, self.width)) / 2;
                        property <length> sc-max-x:
                            -((root.mind-off-x + root.mind-w * 1px / 2) * root.mind-zoom)
                                + (self.width
                                    + max(root.mind-w * 1px * root.mind-zoom, self.width)) / 2;
                        property <length> sc-min-y:
                            -((root.mind-off-y + root.mind-h * 1px / 2) * root.mind-zoom)
                                + (self.height
                                    - max(root.mind-h * 1px * root.mind-zoom, self.height)) / 2;
                        property <length> sc-max-y:
                            -((root.mind-off-y + root.mind-h * 1px / 2) * root.mind-zoom)
                                + (self.height
                                    + max(root.mind-h * 1px * root.mind-zoom, self.height)) / 2;
                        // 菜单/快捷键缩放：以视口中心为锚点重算视口并夹取。
                        // 滚轮路径已在 apply-zoom 内按光标锚点算好，这里靠
                        // zoom-anchor 标记区分，避免两种锚点互相覆盖。
                        // 说明：Slint 的 changed 只能监听本元素属性，故用
                        // zoom-watch 代理 root.mind-zoom 后再监听。
                        // zoom-prev 必须是常量初值 + 手动同步：写成 root.mind-zoom
                        // 会成为绑定，处理器里读到的永远是「新值」而非缩放前值。
                        property <float> zoom-prev: 1.0;
                        property <float> zoom-watch: root.mind-zoom;
                        changed zoom-watch => {
                            if (root.zoom-anchor) {
                                root.zoom-anchor = false;
                                let vpx = self.width / 2;
                                let vpy = self.height / 2;
                                // 缩放前视口中心处的内容点（保持它不动）。
                                let cx = (vpx - self.content-x) / zoom-prev;
                                let cy = (vpy - self.content-y) / zoom-prev;
                                self.content-x = clamp(
                                    vpx - cx * root.mind-zoom, sc-min-x, sc-max-x);
                                self.content-y = clamp(
                                    vpy - cy * root.mind-zoom, sc-min-y, sc-max-y);
                            }
                            zoom-prev = root.mind-zoom;
                        }
                        changed off-watch-x => {
                            flick.content-x = clamp(
                                flick.content-x
                                    - (root.mind-off-x - last-off-x) * root.mind-zoom,
                                flick.sc-min-x,
                                flick.sc-max-x);
                            last-off-x = root.mind-off-x;
                        }
                        changed off-watch-y => {
                            flick.content-y = clamp(
                                flick.content-y
                                    - (root.mind-off-y - last-off-y) * root.mind-zoom,
                                flick.sc-min-y,
                                flick.sc-max-y);
                            last-off-y = root.mind-off-y;
                        }

                        changed width => {
                            last-off-x = root.mind-off-x;
                            last-off-y = root.mind-off-y;
                            root.center-canvas(self.width / 1px, self.height / 1px);
                        }

                        // 视口级空白点击层（Flickable 的第一个子元素 ⇒ 沉在最底层）。
                        // 画布元素被 scale-factor 缩放，它只在自己「世界坐标 × zoom」覆盖到
                        // 的范围内接得住点击：缩小后视口四周会露出一圈没有任何点击层的
                        // 空白，点它什么都不发生（表现为「点空白无法移除激活状态」）。
                        // 这一层用 -content-x/-content-y 抵消滚动、尺寸取视口与内容的大者，
                        // 因此**永远贴合视口**，兜住所有没被连线/节点/面板接走的点击。
                        TouchArea {
                            x: -flick.content-x;
                            y: -flick.content-y;
                            width: max(root.mind-canvas-w * root.mind-zoom, flick.width);
                            height: max(root.mind-canvas-h * root.mind-zoom, flick.height);
                            clicked => { root.clear-activation(); }
                            // 与画布层同款兜底：任何按下都结束「拖拽悬停」态，
                            // 避免上一次拖拽残留的 mind-drag 让平移窜出意外滚动。
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    DndApi.mind-drag = false;
                                    DndApi.mind-pos-x = -1px;
                                    DndApi.mind-pos-y = -1px;
                                }
                            }
                        }

                        // 缩放容器：所有画布内容（空白层 / 连线 / 节点）都在其中，
                        // scale-factor 统一缩放（transform-origin 左上角，与滚动换算一致）。
                        Rectangle {
                            width: root.mind-canvas-w;
                            height: root.mind-canvas-h;
                            // transform-scale 围绕元素中心缩放（transform-origin 在此
                            // 版本未生效）；用位置补偿 center*(zoom-1) 等效为围绕
                            // 左上角 (0,0) 缩放，使渲染像素 = 本地坐标 × zoom。
                            transform-scale: root.mind-zoom;
                            x: root.mind-canvas-w / 2 * (root.mind-zoom - 1);
                            y: root.mind-canvas-h / 2 * (root.mind-zoom - 1);

                        // 空白点击层：覆盖整个画布、位于连线/节点之下。
                        // 点击空白 = 取消分支激活态；滚轮缩放（光标为锚点）。
                        TouchArea {
                            width: root.mind-canvas-w;
                            height: root.mind-canvas-h;
                            clicked => { root.clear-activation(); }
                            // 防御兜底：画布上的任何按下都结束「拖拽悬停」态。若上一次
                            // 拖拽把 mind-drag 残留下来（如拖出窗口后收尾未跑到），
                            // 平移画布时残留的边缘滚动会窜出来造成意外滚动。
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    DndApi.mind-drag = false;
                                    DndApi.mind-pos-x = -1px;
                                    DndApi.mind-pos-y = -1px;
                                }
                            }
                        }

                        // 画布级拖放层：空白区域命中的 DropArea（节点层更晚声明、
                        // 更上层优先）。上报光标位置驱动边缘自动滚动；外部文件
                        // 拖到空白处维持既有语义（导入当前选中分支）。
                        DropArea {
                            width: root.mind-canvas-w;
                            height: root.mind-canvas-h;
                            can-drop(event) => {
                                // 画布空白：先清空其他区域的悬停指示（**含导图节点激活高亮**
                                // —— 拖拽从分支移到空白处时它必须被撤掉），再上报光标位置
                                // 并开启边缘滚动。
                                DndApi.clear-hover();
                                // event.position 为本元素本地坐标（缩放前画布坐标，背景层
                                // 原点即 content 原点）→ 视口像素 = 本地*zoom + content-x。
                                DndApi.mind-pos-x = event.position.x * root.mind-zoom
                                    + flick.content-x;
                                DndApi.mind-pos-y = event.position.y * root.mind-zoom
                                    + flick.content-y;
                                DndApi.mind-drag = true;
                                DndApi.transfer-to-entry(event.data) == ""
                                    && DndApi.transfer-has-files(event.data)
                                    ? DragAction.copy
                                    : DragAction.none;
                            }
                            dropped(event) => {
                                root.external-files-dropped(DndApi.transfer-to-files(event.data));
                                EntryApi.end-drop();
                                return event.proposed-action;
                            }
                            // 拖拽移出画布（到非节点区域 / 窗口外）：关闭边缘滚动。
                            // 守卫：hover-node != -2 说明已被某个节点接管（本层 exit
                            // 晚于对方 can-drop），不能动它的状态；否则清 mind-drag ——
                            // 拖拽移出窗口后没有任何 can-drop 会再跑，不清的话边缘
                            // 滚动一直挂着，之后平移画布会窜出意外滚动。
                            changed has-drag => {
                                if (!self.has-drag && DndApi.hover-node == -2) {
                                    DndApi.mind-drag = false;
                                    DndApi.mind-pos-x = -1px;
                                    DndApi.mind-pos-y = -1px;
                                }
                            }
                        }

                        // 画布连线：按列带合并成的少量 Path（见 MindEdgeChunk）。
                        // 逐条矩形连线在 800 节点量级就是 2400 个 item，逐帧遍历/
                        // 裁剪判定的开销远超绘制本身；合并后每块只有一个 item，
                        // 且包络盒完全在屏幕外的块会被渲染器的裁剪判定直接跳过。
                        for chunk in root.mind-edge-chunks: Path {
                            x: chunk.x * 1px + root.mind-off-x;
                            y: chunk.y * 1px + root.mind-off-y;
                            width: chunk.w * 1px;
                            height: chunk.h * 1px;
                            // 命令串坐标已相对包络盒 ⇒ 不做 viewbox 缩放。
                            fit: preserve;
                            commands: chunk.commands;
                            stroke: c-line;
                            stroke-width: 2px;
                            stroke-line-cap: butt;
                            fill: transparent;
                        }

                        for node in root.mind-nodes: Rectangle {
                            // 容器：与节点等大同位、不裁剪，承载节点主体 + 两个外置按钮。
                            x: node.x * 1px + root.mind-off-x;
                            y: node.y * 1px + root.mind-off-y;
                            width: node.w * 1px;
                            height: node.h * 1px;
                            // ── 视口裁剪（虚拟化）──
                            // 离屏节点 visible:false ⇒ 编译器把 visible 降级为 Clip、裁剪区
                            // 为空 ⇒ 渲染器对该子树「既不遍历也不绘制」（见 Slint
                            // core::item_rendering::visit_clip 的 ContinueRenderingWithoutChildren）。
                            // 超大导图下平移/重绘开销因此只与屏幕内节点数相关，与总节点数无关。
                            // 屏幕位置 = 画布本地坐标 × zoom + 滚动偏移（与各 DropArea 的
                            // 坐标换算同源）；边距覆盖外置子树按钮等溢出节点矩形的部分。
                            property <length> vp-x: self.x * root.mind-zoom + flick.content-x;
                            property <length> vp-y: self.y * root.mind-zoom + flick.content-y;
                            visible: self.vp-x + self.width * root.mind-zoom
                                    >= -(root.mind-cull-margin)
                                && self.vp-x <= flick.width + root.mind-cull-margin
                                && self.vp-y + self.height * root.mind-zoom
                                    >= -(root.mind-cull-margin)
                                && self.vp-y <= flick.height + root.mind-cull-margin;

                            // 子树伸缩：分支右外侧、节点内垂直居中。
                            if node.has-children: MindIconButton {
                                x: parent.width + 4px;
                                y: (parent.height - self.height) / 2;
                                horizontal: true;
                                expanded: node.children-expanded;
                                fg: c-sub;
                                bg-hover: c-hover;
                                clicked => { root.toggle-visit-expand(node.visit); }
                            }

                            // 节点主体
                            nodebody := Rectangle {
                                width: 100%;
                                height: 100%;
                                property <bool> node-hover: DndApi.hover-node == node.visit;
                                // 根节点不再用专用底色（曾是淡/深靛蓝填充，观感与其它节点
                                // 不一致、像卡在选中/悬停态）：统一面板色，靠 root 徽标 +
                                // 加粗标题 + 最左位置区分。
                                background: c-panel;
                                border-radius: 8px;
                                // 边框由最上层覆盖层绘制（见节点末尾），避免内容
                                // 行的激活背景盖住边框线。
                                // 不用 clip：带圆角的裁剪会走 renderer 的离屏层
                                // （render_layer），而该层不继承画布缩放变换——
                                // 内容被位图化后再放大，文字发虚。节点内容本身
                                // 不越界，仅损失圆角处的裁剪。
                                clip: false;

                                // 节点级拖放：内部条目跨节点移入 / 外部文件导入本分支。
                                // 面板行内的行级 DropArea 声明在后（更上层）优先命中；
                                // 这里兜住标题行与面板空白区域，并驱动节点高亮反馈。
                                nodehover := DropArea {
                                    can-drop(event) => {
                                        // 先清空上一个区域的悬停指示，再置本区域状态（规则见 DndApi.clear-hover）。
                                        DndApi.clear-hover();
                                        // 上报光标视口像素坐标：节点在画布坐标系原点
                                        // + 本地坐标（缩放前）→ ×zoom + 滚动偏移。
                                        DndApi.mind-pos-x = (node.x * 1px + root.mind-off-x
                                            + event.position.x) * root.mind-zoom
                                            + flick.content-x;
                                        DndApi.mind-pos-y = (node.y * 1px + root.mind-off-y
                                            + event.position.y) * root.mind-zoom
                                            + flick.content-y;
                                        DndApi.mind-drag = true;
                                        if (DndApi.transfer-to-entry(event.data) != ""
                                            && DndApi.src-visit != node.visit) {
                                            DndApi.hover-node = node.visit;
                                            DndApi.hover-row = -2;
                                            DndApi.hover-panel = -2;
                                            DndApi.hover-files = false;
                                            DragAction.move
                                        } else if (DndApi.transfer-has-files(event.data)) {
                                            DndApi.hover-node = node.visit;
                                            DndApi.hover-row = -2;
                                            DndApi.hover-panel = -2;
                                            DndApi.hover-files = true;
                                            DragAction.copy
                                        } else {
                                            // 同分支内的条目拖拽：本节点不接受落点（行级
                                            // 落点负责精确放置），但**必须认领 hover-node**
                                            // —— 上面的 clear-hover 已把它清成 -2，若不重新
                                            // 写回，激活边框就会在「行 ⇄ 面板空白」间移动时
                                            // 熄灭又点亮（闪烁）。只清行指示：行高亮 / 插入线
                                            // 在面板空白处没有意义。
                                            DndApi.hover-row = -2;
                                            DndApi.hover-half = 0;
                                            DndApi.hover-into-dir = false;
                                            DndApi.hover-sortable = false;
                                            DndApi.hover-files = false;
                                            DndApi.hover-node = node.visit;
                                            DragAction.none
                                        }
                                    }
                                    dropped(event) => {
                                        root.select-visit(node.visit);
                                        if (DndApi.transfer-to-entry(event.data) != "") {
                                            EntryApi.drop-row(
                                                DndApi.transfer-to-entry(event.data),
                                                "",
                                                -1,
                                                false,
                                                false);
                                        } else {
                                            root.external-files-dropped(
                                                DndApi.transfer-to-files(event.data));
                                        }
                                        EntryApi.end-drop();
                                        DndApi.mind-drag = false;
                                        return event.proposed-action;
                                    }
                                    changed has-drag => {
                                        // 拖拽移出本节点：撤掉激活边框与悬停状态。
                                        // 守卫必不可少 —— 移到下一节点时本事件晚于对方
                                        // can-drop，无脑清全会抹掉对方刚写好的高亮
                                        // （守卫为假 = 已被其它区域接管，什么都不做）；
                                        // 守卫为真 = 光标去了非落点区域（侧栏 / 窗口外），
                                        // 此时整树状态都属于本节点，clear-hover 全清是安全的
                                        // （含 mind-drag：边缘滚动必须停，否则移出窗口后
                                        // 残留的滚动会在下次拖动画布时窜出来）。
                                        if (!self.has-drag
                                            && DndApi.hover-node == node.visit)
                                        {
                                            DndApi.clear-hover();
                                        }
                                    }
                                }

                                // 节点级右键菜单（TouchArea 消费右键后手动 show，避免双层菜单）。
                                // 菜单项点击时才激活该分支——右键路径本身不做状态变更，
                                // 否则 select-visit 的模型重建会销毁正在弹出的菜单。
                                nodectx := ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: "新建子分支…";
                                            activated => {
                                                root.select-visit(node.visit);
                                                root.child-dialog-open();
                                            }
                                        }
                                        MenuItem {
                                            title: "重命名分支…";
                                            activated => {
                                                root.select-visit(node.visit);
                                                root.branch-rename-open();
                                            }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: "展开 / 收起子树";
                                            enabled: node.has-children;
                                            activated => { root.toggle-visit-expand(node.visit); }
                                        }
                                        MenuItem {
                                            title: "展开 / 收起内容";
                                            enabled: node.has-entries;
                                            activated => { root.toggle-node-content(node.visit); }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: "在 Finder 中显示";
                                            activated => {
                                                root.select-visit(node.visit);
                                                root.reveal-branch();
                                            }
                                        }
                                        MenuItem {
                                            title: "拷贝路径";
                                            activated => {
                                                root.select-visit(node.visit);
                                                root.branch-copy-path();
                                            }
                                        }
                                        MenuItem {
                                            title: "在终端中显示";
                                            activated => {
                                                root.select-visit(node.visit);
                                                root.branch-reveal-terminal();
                                            }
                                        }
                                        MenuItem {
                                            title: "粘贴";
                                            activated => {
                                                root.select-visit(node.visit);
                                                EntryApi.paste();
                                            }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: "删除分支";
                                            enabled: !node.is-root;
                                            activated => {
                                                root.select-visit(node.visit);
                                                root.delete-branch();
                                            }
                                        }
                                    }
                                }
                                // 节点手势（先声明在底层）：点标题行选中、双击伸缩子树、右键弹菜单。
                                // 左键**只把标题行当节点**：卡片其余部分（内容面板留白、底部伸缩
                                // 箭头带、节点底色）在视觉上就是空白 ⇒ 取消分支激活（与画布空白、
                                // 节点内面板空白同一语义）。旧版整张卡片都 select-visit，于是
                                // 「点卡片空白」会把刚取消的激活又设回去 —— 表现为「分支激活态
                                // 无法移除」。这里**显式**处理空白，不靠 reject 透传到底层空白层：
                                // 能否透传取决于兄弟元素的命中顺序，实测在可缩放的画布上并不稳。
                                TouchArea {
                                    // 双击伸缩子树同样只认标题行：卡片空白上的双击
                                    // 语义是「取消激活」，不该顺带折叠子树。
                                    double-clicked => {
                                        if (self.mouse-y <= root.node-title-h) {
                                            root.toggle-visit-expand(node.visit);
                                        }
                                    }
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.up) {
                                            // 右键整张卡片都算：右键即选中（Finder 语义），
                                            // 菜单操作作用于右键的节点而非之前激活的分支。
                                            root.select-visit(node.visit);
                                            nodectx.show({x: self.mouse-x, y: self.mouse-y});
                                            return EventResult.accept;
                                        }
                                        if (event.button == PointerEventButton.left
                                            && event.kind == PointerEventKind.up) {
                                            // 左键：标题行内 = 选中该节点；其余 = 取消激活。
                                            if (self.mouse-y <= root.node-title-h) {
                                                root.select-visit(node.visit);
                                            } else {
                                                root.clear-activation();
                                            }
                                            return EventResult.accept;
                                        }
                                        return EventResult.reject;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 0px;
                                    // 标题行（高度与 Rust NODE_H 一致，且是节点手势的命中高度）。
                                    HorizontalLayout {
                                        height: root.node-title-h;
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;

                                        Text {
                                            text: node.title;
                                            font-size: 12px;
                                            font-weight: node.is-root || node.is-selected ? 700 : 500;
                                            color: node.is-selected ? c-sel-text : c-text;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: node.type-str;
                                            font-size: 10px;
                                            color: c-sub;
                                            overflow: elide;
                                            visible: node.type-str != "";
                                            vertical-alignment: center;
                                        }
                                    }

                                    // 节点内容 = 与列表视图完全同一套 EntryListPanel（功能一致）。
                                    if node.expanded && node.entry-rows.length > 0: EntryListPanel {
                                        // 高度 = 节点高 - 标题行(28) - 底部内容箭头区(22)，
                                        // 为绝对定位的伸缩箭头留出空间（否则列表会延伸到
                                        // 箭头下方、被箭头遮挡）。
                                        height: node.h * 1px - 50px;
                                        src-visit: node.visit;
                                        entries: node.entry-rows;
                                        selected-index: node.is-selected ? root.entry-selected : -1;
                                        col-text: c-text;
                                        col-sub: c-sub;
                                        col-sel: c-row-sel;
                                        col-row-bg: c-row-bg;
                                        col-on-sel: c-on-accent;
                                        col-drag-bg: c-drag-bg;
                                        col-badge: c-badge-bg;
                                        col-accent: c-accent;
                                        // 节点内嵌面板：点空白 = 取消分支激活
                                        // （与画布空白同一语义，否则「点空白没反应」）。
                                        blank-clicked => { root.clear-activation(); }
                                    }

                                }

                                // 边框覆盖层（最后声明 = 最上层）：节点内容不做裁剪
                                // 后（避免圆角 clip 触发离屏层导致缩放模糊），内容行
                                // 的激活背景会盖住边框线——这里把边框画在内容之上。
                                Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    border-radius: 8px;
                                    border-width:
                                        nodebody.node-hover || node.is-selected ? 2px : 1px;
                                    border-color: nodebody.node-hover
                                        ? c-accent
                                        : (node.is-selected ? c-accent : c-line);
                                    background: transparent;
                                }
                            }

                            // 内容伸缩箭头（⌄ 展开 / ⌃ 收起）：绝对定位复用标题行下方
                            // 的居中留白（未展开时贴文字底）或贴节点底部（展开时），
                            // 不再占独立行——避免「标题行留白 + 箭头行留白」叠加造成
                            // 标题与箭头间距过大。
                            if node.has-entries: MindIconButton {
                                x: (parent.width - self.width) / 2;
                                y: node.expanded
                                    ? parent.height - self.height - 2px
                                    : 20px;
                                expanded: node.expanded;
                                horizontal: false;
                                fg: c-sub;
                                bg-hover: c-hover;
                                clicked => { root.toggle-node-content(node.visit); }
                            }
                        }
                        }
                    }

                    // ── 边缘自动滚动：拖拽在画布边缘带内**悬停片刻**后持续平移 ──
                    tscroll := Timer {
                        // 速度与深入边缘带的深度成正比（最大 12px/帧 ≈ 750px/s）。
                        // 方向：光标在左缘 → 视口左移看左侧内容（content-x 增大，
                        // 因为 content-x 是负的滚动偏移）；右缘同理取负。
                        // 平移范围：视口中心可停在内容包围盒内任意点（见 flick.sc-*），
                        // 允许滚到内容任意边缘附近，又绝不滚到完全看不见内容。
                        interval: 16ms;
                        running: DndApi.mind-drag;
                        // 视口范围约束见 flick.sc-min-x / sc-max-x（滚轮缩放共用）。
                        // 光标相对 mind 视口的位置（can-drop 已换算成视口坐标）。
                        property <length> cur-x: DndApi.mind-pos-x;
                        property <length> cur-y: DndApi.mind-pos-y;
                        property <length> dx:
                            cur-x >= 0px && cur-x < 56px
                                ? (56px - cur-x) / 56px * 12px
                                : (cur-x > flick.width - 56px
                                    ? -(cur-x - (flick.width - 56px)) / 56px * 12px
                                    : 0px);
                        property <length> dy:
                            cur-y >= 0px && cur-y < 56px
                                ? (56px - cur-y) / 56px * 12px
                                : (cur-y > flick.height - 56px
                                    ? -(cur-y - (flick.height - 56px)) / 56px * 12px
                                    : 0px);
                        // 悬停计数：进入边缘带后先停留 320ms 再开始滚动（掠过边缘
                        // 不滚，避免路过时视口乱窜）；移出边缘带即清零重新计时。
                        property <int> dwell: 0;
                        triggered => {
                            if (self.dx == 0px && self.dy == 0px) {
                                self.dwell = 0;
                                return;
                            }
                            self.dwell = self.dwell + 1;
                            if (self.dwell * 16ms < 320ms) {
                                return;
                            }
                            // 共用 flick 的视口范围约束（max/min 组合：视口过大
                            // 时区间可能反转，退化到靠内容一侧）。
                            flick.content-x = max(flick.sc-min-x, min(
                                flick.content-x + self.dx,
                                flick.sc-max-x));
                            flick.content-y = max(flick.sc-min-y, min(
                                flick.content-y + self.dy,
                                flick.sc-max-y));
                        }
                    }

                    // ── 缩放比例提示 ──
                    // 仅非 1:1 时显示（左下角），与右下角小地图对角分布、互不遮挡。
                    if root.mind-zoom != 1.0: Rectangle {
                        x: 12px;
                        y: parent.height - self.height - 12px;
                        width: 48px;
                        height: 20px;
                        border-radius: 6px;
                        background: root.dark-mode ? #24262cd9 : #ffffffd9;
                        border-width: 1px;
                        border-color: c-line;
                        Text {
                            text: "\{Math.round(root.mind-zoom * 100)}%";
                            font-size: 11px;
                            color: c-sub;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // ── 小地图：内容缩略 + 视口指示框，点击/拖动导航 ──
                    minimap := Rectangle {
                        x: parent.width - self.width - 12px;
                        y: parent.height - self.height - 12px;
                        // 面板尺寸 = 内容盒 + 8px 内边距：块状形态随内容包围盒自适应
                        // （缩略图紧贴面板边缘，无大片留白），密度形态固定 184×116。
                        // 缩略比例必须与面板宽度同源（都按「内容实际宽度」= mind-w 减去
                        // 右侧的子树按钮占位，缩略图不画按钮）——只扣宽度不扣比例，
                        // 内容就会超出面板右缘（被 clip 掩盖，clip 一失效就露出来）。
                        width: root.mini-box-w + 16px;
                        height: root.mini-box-h + 16px;
                        background: root.dark-mode ? #24262cd9 : #ffffffd9;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: c-line;
                        // 内容裁剪放在内层直角容器上：带圆角的 clip 在渲染器里要走离屏层
                        // （每帧建 FBO + 合成整棵子树），直角裁剪只是 scissor；圆角观感由
                        // 外层背景提供，而内容留了 8px 内边距、碰不到四角。
                        Rectangle {
                            clip: true;

                            // ── 密度形态（超大导图）──
                            // 单个节点块不足 2px 时，逐项绘制只会堆叠成认不出的色块；
                            // 改为显示 Rust 侧烘焙的位图（覆盖度 → 透明度、连线骨架、
                            // 选中链用强调色），内容两轴铺满面板，每帧只有 1 个 item。
                            if root.mini-dense: Image {
                                x: 8px;
                                y: 8px;
                                width: root.mini-box-w;
                                height: root.mini-box-h;
                                source: root.mind-mini-image;
                                image-fit: fill;
                            }

                            // ── 块状形态（个体可分辨）──
                            // 连接线：与画布同一份连线几何，合并为整图一条 Path。
                            // 先画线后画节点，保证节点块压在线上；用与普通节点相同的
                            // 颜色/透明度，靠「线细」自然弱于块状节点，不抢视觉主次。
                            // viewbox = 连线包络盒 ⇒ 命令串保持内容坐标，由 Slint 缩放到
                            // 面板尺寸；线宽按面板像素给 1px（缩放后不足 1px 会消失）。
                            if !root.mini-dense: Rectangle {
                                for chunk in root.mind-mini-edge-chunks: Path {
                                    x: 8px + chunk.x * root.mini-sx * 1px;
                                    y: 8px + chunk.y * root.mini-sy * 1px;
                                    width: chunk.w * root.mini-sx * 1px;
                                    height: chunk.h * root.mini-sy * 1px;
                                    viewbox-x: chunk.x;
                                    viewbox-y: chunk.y;
                                    viewbox-width: chunk.w;
                                    viewbox-height: chunk.h;
                                    fit: fill;
                                    commands: chunk.commands;
                                    // 用带透明度的颜色而不是 opacity：后者会给每个 item
                                    // 引入一个 Opacity 元素（必要时还要离屏层）。
                                    stroke: c-sub.transparentize(0.8);
                                    stroke-width: 1px;
                                    stroke-line-cap: butt;
                                    fill: transparent;
                                }

                                for node in root.mind-nodes: Rectangle {
                                    x: 8px + node.x * root.mini-sx * 1px;
                                    y: 8px + node.y * root.mini-sy * 1px;
                                    width: max(node.w * root.mini-sx * 1px, 2px);
                                    height: max(node.h * root.mini-sy * 1px, 1.5px);
                                    border-radius: 1px;
                                    // 透明度写进颜色（而非 opacity）：后者每个 item 都要多
                                    // 一个 Opacity 元素，节点上千时是纯浪费。
                                    background: node.is-selected
                                        ? c-accent.transparentize(0.45)
                                        : (node.is-root
                                            ? c-badge-text.transparentize(0.45)
                                            : c-sub.transparentize(0.8));
                                }
                            }

                            // 视口指示块：视口在内容坐标系中的位置（绝对 = -content-x），
                            // clamp 到面板全域——视口平出内容时色块贴到面板边缘而非消失。
                            Rectangle {
                                // 视口的画布坐标（缩放前）= -content-x / zoom，再减 off。
                                // 两轴比例分别取 mini-sx / mini-sy：密度形态下它们不等。
                                property <length> vl: clamp(
                                    8px + ((-flick.content-x / 1px) / root.mind-zoom
                                        - (root.mind-off-x / 1px)) * root.mini-sx * 1px,
                                    8px, minimap.width - 8px);
                                property <length> vr: clamp(
                                    8px + (((-flick.content-x / 1px) + flick.width / 1px)
                                        / root.mind-zoom
                                        - (root.mind-off-x / 1px)) * root.mini-sx * 1px,
                                    8px, minimap.width - 8px);
                                property <length> vt: clamp(
                                    8px + ((-flick.content-y / 1px) / root.mind-zoom
                                        - (root.mind-off-y / 1px)) * root.mini-sy * 1px,
                                    8px, minimap.height - 8px);
                                property <length> vb: clamp(
                                    8px + (((-flick.content-y / 1px) + flick.height / 1px)
                                        / root.mind-zoom
                                        - (root.mind-off-y / 1px)) * root.mini-sy * 1px,
                                    8px, minimap.height - 8px);
                                x: vl;
                                y: vt;
                                width: max(vr - vl, 0px);
                                height: max(vb - vt, 0px);
                                background: c-accent;
                                opacity: 0.15;
                                // 描边层不随填充层降透明度，块贴边时边界依然清晰。
                                Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 2px;
                                    border-width: 1.5px;
                                    border-color: c-accent;
                                    background: transparent;
                                }
                            }
                        }

                        TouchArea {
                            // 点击/拖动小地图：把视口中心对到指针处。
                            function jump() {
                                // 小地图坐标 → 内容包围盒坐标 → 画布坐标（+off）→
                                // 像素坐标（×zoom）→ 视口中心对齐 → content-x = -p；
                                // 范围用与缩放/边缘滚动一致的 sc 约束（内容中心可见）。
                                flick.content-x = clamp(
                                    -(((self.mouse-x - 8px) / 1px / root.mini-sx
                                        + (root.mind-off-x / 1px))
                                        * root.mind-zoom * 1px - flick.width / 2),
                                    flick.sc-min-x,
                                    flick.sc-max-x);
                                flick.content-y = clamp(
                                    -(((self.mouse-y - 8px) / 1px / root.mini-sy
                                        + (root.mind-off-y / 1px))
                                        * root.mind-zoom * 1px - flick.height / 2),
                                    flick.sc-min-y,
                                    flick.sc-max-y);
                            }
                            clicked => { jump(); }
                            moved => { if (self.pressed) { jump(); } }
                            // 双击小地图：重置为 1:1（以视口中心为锚点）。
                            double-clicked => {
                                flick.apply-zoom(
                                    1.0,
                                    (flick.width / 2 - flick.content-x) / root.mind-zoom,
                                    (flick.height / 2 - flick.content-y) / root.mind-zoom);
                            }
                            // 滚轮缩放（仅小地图）：以视口中心为锚点，缩放时
                            // 屏幕中心对准的内容点保持不动。
                            scroll-event(event) => {
                                if (event.delta-y != 0px) {
                                    flick.zoom-at(
                                        (flick.width / 2 - flick.content-x) / root.mind-zoom,
                                        (flick.height / 2 - flick.content-y) / root.mind-zoom,
                                        event.delta-y);
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                        }
                    }
                }
            }

            // 中：内容条目区（仅列表视图显示）
            if !root.view-mind: Rectangle {
                horizontal-stretch: 1;
                background: c-panel;
                border-radius: 10px;
                // 裁剪放在内层直角容器（同上）：内容自带 16px 内边距，远离圆角。
                Rectangle {
                    clip: true;


                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;

                        Text {
                            text: "内容";
                            font-size: 13px;
                            font-weight: 700;
                            color: c-text;
                        }
                        EntryListPanel {
                            vertical-stretch: 2;
                            src-visit: DndApi.src-visit;
                            entries: root.entries;
                            selected-index: root.entry-selected;
                            col-text: c-text;
                            col-sub: c-sub;
                            col-sel: c-row-sel;
                            col-row-bg: c-row-bg;
                            col-on-sel: c-on-accent;
                            col-drag-bg: c-drag-bg;
                            col-badge: c-badge-bg;
                            col-accent: c-accent;
                            // 列表视图：点空白只清内容选区，当前分支仍是激活分支
                            // （Finder 语义：点文件列表空白不会退出当前文件夹）。
                            blank-clicked => {
                                EntryApi.activate-visit(DndApi.src-visit);
                                EntryApi.clear-selection();
                            }
                        }



                    }
                }
            }

            // 右：信息侧栏（分支 / 条目，标签页可自由切换）
            Rectangle {
                width: 320px;
                background: c-panel;
                border-radius: 10px;
                // 裁剪放在内层直角容器（同上）：标签页内容自带 16px 内边距，远离圆角。
                Rectangle {
                    clip: true;


                    TabWidget {
                        current-index <=> root.info-tab;

                        Tab {
                            title: "分支";
                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: root.has-selection
                                            ? (root.d-title == "" ? "（无标题）" : root.d-title)
                                            : "未选择分支";
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: c-text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.d-kind;
                                        font-size: 12px;
                                        color: c-sub;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "id：" + root.d-id; font-size: 11px; color: c-sub; overflow: elide; }
                                }

                                Rectangle { height: 1px; background: c-line; }

                                if root.has-selection: VerticalLayout {
                                    spacing: 8px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        Text { text: "标题"; font-size: 12px; color: c-sub; }
                                        LineEdit {
                                            enabled: root.has-selection;
                                            placeholder-text: "分支标题";
                                            text <=> root.d-title;
                                        }
                                    }
                                    if !root.is-root: VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        Text { text: root.is-root ? "类型（ROOT 无 type 字段）" : "类型"; font-size: 12px; color: c-sub; }
                                        LineEdit {
                                            enabled: root.has-selection && !root.is-root;
                                            placeholder-text: "如 code.project（点分命名空间）";
                                            text <=> root.d-type;
                                        }
                                    }

                                    Text { text: "摘要"; font-size: 12px; color: c-sub; }
                                    // 多行摘要：TextEdit 支持换行（写入 TOML 时由 toml_edit
                                    // 转义 \n，读回原样）。
                                    TextEdit {
                                        enabled: root.has-selection;
                                        placeholder-text: "供人与 AI 路由检索的一句话摘要";
                                        text <=> root.d-summary;
                                        wrap: TextWrap.word-wrap;
                                        height: 60px;
                                    }

                                    Text { text: "标签（逗号分隔）"; font-size: 12px; color: c-sub; }
                                    LineEdit {
                                        enabled: root.has-selection;
                                        placeholder-text: "标签1, 标签2";
                                        text <=> root.d-tags;
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button {
                                            text: "保存";
                                            enabled: root.has-selection;
                                            clicked => { root.save-details(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Button {
                                            text: "删除分支";
                                            enabled: root.has-selection && !root.is-root;
                                            clicked => { root.delete-branch(); }
                                        }
                                    }
                                    // 空间吸收元素：本 VerticalLayout 内除输入框外没有弹性项，
                                    // 一旦它被分到比内容首选高更多的可用高度（例如 TabWidget
                                    // 用某个 Tab 的首选高统一内容区高度），Slint 会按数量把多余
                                    // 空间均摊给所有子项——表现为「标题/标签框、保存按钮一起被
                                    // 撑高、间距变大」。放一个拉伸项吸收多余空间即可锁住各控件
                                    // 的首选高度。
                                    Rectangle { vertical-stretch: 1; }
                                }
                                Rectangle { vertical-stretch: 1; }

                                // 底部信息：修订号与更新时间（置于弹性空白之后，贴面板底部）
                                // 左 rev、右更新时间：用横向弹性空白把二者顶到两端。
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "rev " + root.d-revision; font-size: 11px; color: c-sub; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: root.d-updated; font-size: 11px; color: c-sub; overflow: elide; }
                                }
                            }
                        }

                        Tab {
                            title: "条目";
                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: root.entry-selected >= 0
                                            ? (root.e-title == "" ? "（无标题）" : root.e-title)
                                            : "未选择条目";
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: c-text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.e-kind;
                                        font-size: 12px;
                                        color: c-sub;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }
                                }

                                // ── 多选视图（>1）：与单选表单**完全不同**的展现 ——
                                // 摘要 + 整组操作，不显示单条目编辑表单。
                                if EntryApi.multi-count > 1: VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: EntryApi.multi-summary;
                                        font-size: 13px;
                                        color: c-text;
                                        wrap: TextWrap.word-wrap;
                                    }
                                    Text {
                                        text: "以下操作作用于整个选区；点击单个条目可查看与编辑其详情。";
                                        font-size: 11px;
                                        color: c-sub;
                                        wrap: TextWrap.word-wrap;
                                    }
                                    Rectangle { height: 1px; background: c-line; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button {
                                            text: "重命名…";
                                            clicked => { EntryApi.entries-batch-rename(); }
                                        }
                                        Button {
                                            text: "拷贝";
                                            // index = -1：Rust 侧解析为整个选区。
                                            clicked => { EntryApi.entry-copy(); }
                                        }
                                        Button {
                                            text: "剪切";
                                            clicked => { EntryApi.entry-cut(); }
                                        }
                                        Button {
                                            text: "移到废纸篓";
                                            clicked => { EntryApi.delete-entry(); }
                                        }
                                    }
                                    Rectangle { vertical-stretch: 1; }
                                }

                                // ── 单选 / 无选区视图：路径 + 单条目表单。
                                if EntryApi.multi-count <= 1: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "路径：" + root.e-path; font-size: 11px; color: c-sub; overflow: elide; }
                                    }
                                    Rectangle { height: 1px; background: c-line; }
                                    if root.entry-selected >= 0: VerticalLayout {
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 8px;
                                                Text { text: "标题"; font-size: 12px; color: c-sub; }
                                                LineEdit {
                                                    width: 100%;
                                                    enabled: root.entry-editable;
                                                    placeholder-text: "标题";
                                                    text <=> root.e-title;
                                                }
                                            }
                                            VerticalLayout {
                                                width: 60px;
                                                spacing: 8px;
                                                Text { text: "排序"; font-size: 12px; color: c-sub; }
                                                LineEdit {
                                                    width: 100%;
                                                    enabled: root.entry-editable;
                                                    placeholder-text: "空";
                                                    text <=> root.e-order;
                                                }
                                            }
                                        }
                                        Text { text: "备注"; font-size: 12px; color: c-sub; }
                                        // 多行备注（同上：换行经 TOML 转义后原样往返）。
                                        TextEdit {
                                            enabled: root.entry-editable;
                                            placeholder-text: "备注";
                                            text <=> root.e-note;
                                            wrap: TextWrap.word-wrap;
                                            height: 72px;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "保存";
                                                enabled: root.entry-editable;
                                                clicked => { EntryApi.save-entry(); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Button {
                                                text: "移到废纸篓";
                                                clicked => { EntryApi.delete-entry(); }
                                            }
                                        }
                                        // 空间吸收元素：缺了它表单子项（按钮/输入框）会被
                                        // 拉伸填满剩余高度（样式异常）。
                                        Rectangle { vertical-stretch: 1; }
                                    }
                                    // 空间吸收元素：理由同「分支」页——内层布局缺拉伸项时，
                                    // 多余可用高度会被均摊给所有子项（输入框、按钮一起被撑高）。
                                    Rectangle { vertical-stretch: 1; }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }

        // ── 状态栏 ──
        Rectangle {
            height: 26px;
            border-radius: 6px;
            background: c-status-bg;
            Text {
                text: root.status;
                font-size: 12px;
                color: c-sub;
                vertical-alignment: center;
                x: 10px;
                overflow: elide;
                width: parent.width - 20px;
            }
        }
    }

    // ── 空状态首页（未打开 bundle 时盖住主界面，给出行动入口）──
    // 窗口级 DropArea 仍生效：拖入 .str 目录 = 直接打开。
    if !root.has-bundle: Rectangle {
        background: c-window;
        VerticalBox {
            padding: 24px;
            spacing: 0px;
            Rectangle { vertical-stretch: 1; }
            Text {
                text: "STR 编辑器";
                vertical-stretch: 0;
                font-size: 26px;
                font-weight: 700;
                color: c-text;
                horizontal-alignment: center;
            }
            Rectangle { height: 8px; }
            Text {
                text: "用「目录树 + 思维导图」管理结构化资源 —— 人类与 AI Agent 共用同一份 .str 数据。";
                vertical-stretch: 0;
                wrap: word-wrap;
                font-size: 13px;
                color: c-sub;
                horizontal-alignment: center;
            }
            Rectangle { height: 24px; }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 10px;
                Rectangle { horizontal-stretch: 1; }
                Button { text: "打开 bundle…"; clicked => { root.open-bundle(); } }
                Button { text: "新建 bundle…"; clicked => { root.new-bundle(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { height: 20px; }
            Text {
                text: "把 .str 目录拖进窗口即可打开；也可以在终端执行 str init 创建。";
                vertical-stretch: 0;
                font-size: 12px;
                color: c-sub;
                horizontal-alignment: center;
            }
            Rectangle { height: 4px; }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 4px;
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "想让 AI Agent 参与协作？安装 str-skill 技能包。";
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    font-size: 12px;
                    color: c-sub;
                    vertical-alignment: center;
                }
                WelcomeLink {
                    text: "接入指引：str-gui/README.md ↗";
                    width: 200px;
                    tint: c-accent;
                    clicked => { root.open-doc(3); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }

    // ── 新建子分支对话框（结构树右键触发）──
    if root.branch-dialog-visible: Rectangle {
        background: #00000066;
        TouchArea { clicked => { } }
        // FocusScope 承载 Esc / Enter：焦点在输入框内时按键沿父链冒泡到此。
        // 不参与点击聚焦与 Tab 导航，避免抢走输入框的焦点 / 打乱 Tab 顺序。
        FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if (event.text == "\u{1b}") {
                    root.child-dialog-cancel();
                    return EventResult.accept;
                }
                if (event.text == "\n" || event.text == "\u{d}") {
                    if (root.bc-title != "") {
                        root.child-dialog-create();
                    }
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            Rectangle {
                width: 440px;
                // 高度需容纳：标题 + 两组「标签+输入框」+ 按钮行（含内边距与间距）。
                height: 286px;
                background: c-panel;
                border-radius: 12px;
                VerticalBox {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: "新建子分支"; font-size: 17px; font-weight: 700; color: c-text; }
                    Text { text: "标题"; font-size: 12px; color: c-sub; }
                    // 对话框弹出即聚焦首个输入框（子组件在 `if` 为真时创建，init 随之执行）。
                    LineEdit {
                        placeholder-text: "分支标题";
                        text <=> root.bc-title;
                        init => { self.focus(); }
                        // 回车在框内被输入框消费 → 走这里（与上面的 FocusScope 分支互斥）。
                        accepted(text) => {
                            if (root.bc-title != "") {
                                root.child-dialog-create();
                            }
                        }
                    }
                    Text { text: "类型（可选，点分命名空间）"; font-size: 12px; color: c-sub; }
                    LineEdit { placeholder-text: "如 code.docs"; text <=> root.bc-type; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "取消"; clicked => { root.child-dialog-cancel(); } }
                        Button {
                            text: "创建";
                            enabled: root.bc-title != "";
                            clicked => { root.child-dialog-create(); }
                        }
                    }
                }
            }
        }
    }

    // ── 重命名对话框 ──
    if root.rename-visible: Rectangle {
        background: #00000066;
        TouchArea { clicked => { } }
        FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if (event.text == "\u{1b}") {
                    root.rename-cancel();
                    return EventResult.accept;
                }
                if (event.text == "\n" || event.text == "\u{d}") {
                    if (root.rename-name != "") {
                        root.rename-confirm();
                    }
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            Rectangle {
                width: 420px;
                height: 190px;
                background: c-panel;
                border-radius: 12px;
                VerticalBox {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: "重命名"; font-size: 17px; font-weight: 700; color: c-text; }
                    LineEdit {
                        text <=> root.rename-name;
                        placeholder-text: "新名称";
                        // 弹出即聚焦并全选旧名：直接输入即替换，避免手工清空。
                        init => { self.focus(); self.select-all(); }
                        accepted(text) => {
                            if (root.rename-name != "") {
                                root.rename-confirm();
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "取消"; clicked => { root.rename-cancel(); } }
                        Button {
                            text: "确定";
                            enabled: root.rename-name != "";
                            clicked => { root.rename-confirm(); }
                        }
                    }
                }
            }
        }
    }

    // ── 重命名分支对话框（改的是显示名 `._meta.title`，不是磁盘目录名）──
    if root.branch-rename-visible: Rectangle {
        background: #00000066;
        TouchArea { clicked => { } }
        FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if (event.text == "\u{1b}") {
                    root.branch-rename-cancel();
                    return EventResult.accept;
                }
                if (event.text == "\n" || event.text == "\u{d}") {
                    // 留空是合法输入（= 清除标题），故不设非空门槛。
                    root.branch-rename-confirm();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            Rectangle {
                width: 440px;
                height: 216px;
                background: c-panel;
                border-radius: 12px;
                VerticalBox {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: "重命名分支"; font-size: 17px; font-weight: 700; color: c-text; }
                    Text {
                        text: "只改显示名（`._meta.title`）；分支目录名是 UUID，不参与重命名。留空即清除标题。";
                        font-size: 11px;
                        color: c-sub;
                        wrap: TextWrap.word-wrap;
                    }
                    LineEdit {
                        text <=> root.branch-rename-name;
                        placeholder-text: "分支标题";
                        // 弹出即聚焦并全选旧标题：直接输入即替换。
                        init => { self.focus(); self.select-all(); }
                        accepted(text) => { root.branch-rename-confirm(); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "取消"; clicked => { root.branch-rename-cancel(); } }
                        Button { text: "确定"; clicked => { root.branch-rename-confirm(); } }
                    }
                }
            }
        }
    }

    // ── 新建 bundle 对话框 ──
    if root.dialog-visible: Rectangle {
        background: #00000066;
        TouchArea { clicked => { } }
        FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if (event.text == "\u{1b}") {
                    root.dialog-cancel();
                    return EventResult.accept;
                }
                if (event.text == "\n" || event.text == "\u{d}") {
                    if (root.new-name != "" && root.dir-picked) {
                        root.dialog-create();
                    }
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            Rectangle {
                width: 450px;
                height: 276px;
                background: c-panel;
                border-radius: 12px;
                VerticalBox {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: "新建 bundle"; font-size: 17px; font-weight: 700; color: c-text; }
                    Text { text: "名称"; font-size: 12px; color: c-sub; }
                    LineEdit {
                        placeholder-text: "如 我的项目";
                        text <=> root.new-name;
                        init => { self.focus(); }
                        accepted(text) => {
                            if (root.new-name != "" && root.dir-picked) {
                                root.dialog-create();
                            }
                        }
                    }
                    Text { text: "位置"; font-size: 12px; color: c-sub; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.dir-picked ? root.new-dir : "（点击「选择位置」）";
                            font-size: 12px;
                            color: c-text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Button { text: "选择位置…"; clicked => { root.dialog-browse(); } }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "取消"; clicked => { root.dialog-cancel(); } }
                        Button {
                            text: "创建";
                            enabled: root.new-name != "" && root.dir-picked;
                            clicked => { root.dialog-create(); }
                        }
                    }
                }
            }
        }
    }

    // ── 关于对话框 ──
    if root.about-visible: Rectangle {
        background: #00000066;
        // 吞掉背景点击，防误触底层控件
        TouchArea { clicked => { } }
        Rectangle {
            width: 460px;
            height: 330px;
            background: c-panel;
            border-radius: 12px;
            // 本对话框没有输入框 → 放一个不可见的焦点锚点持有焦点，
            // 按键（Esc / Enter）投递到这里即关闭；其余对话框由输入框的父链承接。
            FocusScope {
                width: 0px;
                height: 0px;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                init => { self.focus(); }
                key-pressed(event) => {
                    if (event.text == "\u{1b}" || event.text == "\n" || event.text == "\u{d}") {
                        root.about-visible = false;
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            VerticalBox {
                padding: 24px;
                spacing: 6px;
                Text {
                    text: "STR 编辑器";
                    font-size: 20px;
                    font-weight: 700;
                    color: c-text;
                    horizontal-alignment: center;
                }
                Text {
                    text: "STR 结构化树资源（.str）bundle 编辑器";
                    font-size: 12px;
                    color: c-sub;
                    horizontal-alignment: center;
                }
                Rectangle { height: 1px; background: c-line; }
                VerticalLayout {
                    spacing: 6px;
                    AboutRow {
                        label: "应用版本";
                        value: root.about-app-version;
                        label-color: c-sub;
                        value-color: c-text;
                    }
                    AboutRow {
                        label: "库 / CLI";
                        value: "str-format \{root.about-lib-version}";
                        label-color: c-sub;
                        value-color: c-text;
                    }
                    AboutRow {
                        label: "规范版本";
                        value: "v\{root.about-spec-version}（str 主版本 \{root.about-str-major}）";
                        label-color: c-sub;
                        value-color: c-text;
                    }
                    AboutRow {
                        label: "仓库";
                        value: root.about-repository;
                        label-color: c-sub;
                        value-color: c-text;
                    }
                    AboutRow {
                        label: "许可证";
                        value: root.about-license;
                        label-color: c-sub;
                        value-color: c-text;
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "关闭"; clicked => { root.about-visible = false; } }
                }
            }
        }
    }

    // ── 快捷键一览（帮助 → 快捷键一览…）──
    // 应用自身的快捷键与鼠标手势都在菜单里没有说明，这里集中列出（内容由 Rust 提供，
    // 分组标题按表的 `head` 标记绘制）。
    if root.shortcuts-visible: Rectangle {
        background: #00000066;
        TouchArea { clicked => { } }
        Rectangle {
            width: 560px;
            height: 540px;
            background: c-panel;
            border-radius: 12px;
            // 无输入框（同「关于」）：用不可见的焦点锚点承接 Esc / Enter。
            FocusScope {
                width: 0px;
                height: 0px;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                init => { self.focus(); }
                key-pressed(event) => {
                    if (event.text == "\u{1b}" || event.text == "\n" || event.text == "\u{d}") {
                        root.shortcuts-visible = false;
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            VerticalBox {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: "快捷键与操作一览";
                    font-size: 18px;
                    font-weight: 700;
                    color: c-text;
                }
                Rectangle { height: 1px; background: c-line; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 3px;
                        for sc in root.shortcuts: VerticalLayout {
                            spacing: 3px;
                            if sc.head: Rectangle { height: 10px; }
                            if sc.head: Text {
                                text: sc.group;
                                font-size: 12px;
                                font-weight: 700;
                                color: c-accent;
                            }
                            ShortcutRow {
                                name: sc.name;
                                keys: sc.keys;
                                name-color: c-text;
                                keys-color: c-sub;
                                keys-bg: c-hover;
                            }
                        }
                        Rectangle { height: 6px; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "关闭"; clicked => { root.shortcuts-visible = false; } }
                }
            }
        }
    }

    // ── 批量操作：进行中进度（内容条目批量删除 / 批量重命名共用）──
    if root.batch-busy: Rectangle {
        background: #00000066;
        TouchArea { clicked => { } }
        Rectangle {
            width: 380px;
            height: 132px;
            background: c-panel;
            border-radius: 12px;
            VerticalBox {
                padding: 20px;
                spacing: 10px;
                Text { text: "批量操作进行中…"; font-size: 16px; font-weight: 700; color: c-text; }
                Text { text: root.progress-text; font-size: 12px; color: c-sub; overflow: elide; }
                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: c-hover;
                    Rectangle {
                        x: 0;
                        width: parent.width * Math.min(1.0,
                            root.progress-total > 0 ? root.progress-done / root.progress-total : 0.0);
                        border-radius: 4px;
                        background: c-sel;
                    }
                }
                Text { text: root.progress-done + " / " + root.progress-total; font-size: 11px; color: c-sub; }
            }
        }
    }

    // ── 批量操作：完成汇总（失败项可重试）──
    if root.summary-visible: Rectangle {
        background: #00000066;
        TouchArea { clicked => { } }
        FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            // 必须主动持有焦点，Esc 才能进到 key-pressed（与其它对话框一致）。
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == "\u{1b}") {
                    root.summary-close();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            Rectangle {
                width: 480px;
                height: 380px;
                background: c-panel;
                border-radius: 12px;
                VerticalBox {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: root.summary-title; font-size: 16px; font-weight: 700; color: c-text; }
                    ListView {
                        vertical-stretch: 1;
                        for r in root.summary-rows: Rectangle {
                            height: 26px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: r.status;
                                    width: 18px;
                                    color: r.status == "✓" ? #3c9a50 : (r.status == "↓" ? c-sub : #c04545);
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: r.title;
                                    color: c-text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: r.message;
                                    font-size: 11px;
                                    color: c-sub;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "重试失败项";
                            visible: root.summary-has-failed;
                            clicked => { root.summary-retry(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "关闭"; clicked => { root.summary-close(); } }
                    }
                }
            }
        }
    }

    // ── 批量重新命名（对标 Finder「批量重新命名…」：替换文本 / 添加文本）──
    if root.br-visible: Rectangle {
        background: #00000066;
        TouchArea { clicked => { } }
        FocusScope {
            width: 100%;
            height: 100%;
            focus-on-click: false;
            // 必须主动持有焦点，Esc 才能进到 key-pressed（与其它对话框一致）。
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == "\u{1b}") {
                    root.br-cancel();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            Rectangle {
                width: 440px;
                height: 250px;
                background: c-panel;
                border-radius: 12px;
                VerticalBox {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: "批量重新命名（已选 " + EntryApi.multi-count + " 项）"; font-size: 16px; font-weight: 700; color: c-text; }
                    ComboBox {
                        model: ["替换文本", "添加文本"];
                        current-index <=> root.br-mode;
                    }
                    // 模式 0 = 替换文本：查找 / 替换为；模式 1 = 添加文本：前缀 / 后缀。
                    if root.br-mode == 0: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "查找"; font-size: 12px; color: c-sub; }
                            LineEdit { placeholder-text: "要替换的文本"; text <=> root.br-find; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "替换为"; font-size: 12px; color: c-sub; }
                            LineEdit { placeholder-text: "可为空（删除该文本）"; text <=> root.br-replace; }
                        }
                    }
                    if root.br-mode == 1: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "前缀"; font-size: 12px; color: c-sub; }
                            LineEdit { placeholder-text: "添加在名称前"; text <=> root.br-prefix; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "后缀（自动加在扩展名前）"; font-size: 12px; color: c-sub; }
                            LineEdit { placeholder-text: "如 -草案"; text <=> root.br-suffix; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "取消"; clicked => { root.br-cancel(); } }
                        Button { text: "应用"; clicked => { root.br-apply(); } }
                    }
                }
            }
        }
    }
}
