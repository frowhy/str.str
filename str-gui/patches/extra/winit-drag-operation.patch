+    /// str-gui patch: mark whether an external file drag is hovering this view.
+    /// While set, `resetCursorRects` installs the copy (+) cursor so window
+    /// activation mid-drag does not reset the cursor to the default arrow.
+    pub(super) fn set_drag_cursor_active(&self, active: bool) {
+        self.ivars().drag_cursor_active.set(active);
+    }
+
+    pub(super) fn drag_cursor_active(&self) -> bool {
+        self.ivars().drag_cursor_active.get()
+    }
+
+    /// str-gui patch: while an external file drag hovers the view, a repeating
+    /// timer (scheduled in common modes, so it fires during the event-tracking
+    /// drag session) re-asserts the copy (+) cursor every 0.1 s — AppKit resets
+    /// the cursor when the window is activated mid-drag, and without mouse
+    /// motion no `draggingUpdated:` fires to correct it.
+    pub(super) fn start_drag_cursor_timer(&self) {
+        self.stop_drag_cursor_timer();
+        let block = block2::RcBlock::new(move |_timer: std::ptr::NonNull<NSTimer>| {
+            unsafe { NSCursor::dragCopyCursor().set() };
+        });
+        let timer = unsafe {
+            NSTimer::scheduledTimerWithTimeInterval_repeats_block(0.1, true, &block)
+        };
+        unsafe {
+            let run_loop = NSRunLoop::mainRunLoop();
+            run_loop.addTimer_forMode(&timer, NSRunLoopCommonModes);
+        }
+        self.ivars().drag_cursor_timer.replace(Some(timer));
+    }
+
+    pub(super) fn stop_drag_cursor_timer(&self) {
+        if let Some(timer) = self.ivars().drag_cursor_timer.take() {
+            unsafe { timer.invalidate() };
+        }
+    }
+
