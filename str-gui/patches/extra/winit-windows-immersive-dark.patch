+/// str-gui patch: 用有文档的 `DWMWA_USE_IMMERSIVE_DARK_MODE` 显式设置窗口框架明暗。
+/// 属性号 20 自 Windows 10 2004 起可用；1809~1909 只能用它当时的 19，故两者都试。
+/// 不支持的构建会返回错误码，因此调用是安全的。
+fn set_immersive_dark_mode(hwnd: HWND, is_dark_mode: bool) -> bool {
+    use windows_sys::Win32::Graphics::Dwm::{
+        DwmSetWindowAttribute, DWMWA_USE_IMMERSIVE_DARK_MODE,
+    };
+
+    let value = BOOL::from(is_dark_mode);
+    for attribute in [DWMWA_USE_IMMERSIVE_DARK_MODE as u32, 19u32] {
+        let hr = unsafe {
+            DwmSetWindowAttribute(
+                hwnd,
+                attribute,
+                &value as *const BOOL as *const c_void,
+                std::mem::size_of::<BOOL>() as u32,
+            )
+        };
+        if hr == S_OK {
+            return true;
+        }
+    }
+    false
+}
