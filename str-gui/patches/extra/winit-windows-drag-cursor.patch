+    /// str-gui patch: deliver a `CursorMoved` from the OLE drag's screen point,
+    /// converted to client physical coordinates. During an OLE drag session no
+    /// mouse-move events are delivered, so without this the drag cursor position
+    /// never updates and position-dependent drop targets cannot resolve.
+    unsafe fn emit_drag_cursor_moved(this: *mut IDropTarget, pt: *const POINTL) {
+        let drop_handler = unsafe { Self::from_interface(this) };
+        if pt.is_null() {
+            return;
+        }
+        let mut point = POINT { x: unsafe { (*pt).x }, y: unsafe { (*pt).y } };
+        unsafe { ScreenToClient(drop_handler.window, &mut point) };
+        drop_handler.send_event(Event::WindowEvent {
+            window_id: RootWindowId(WindowId(drop_handler.window)),
+            event: crate::event::WindowEvent::CursorMoved {
+                device_id: super::DEVICE_ID,
+                position: crate::dpi::PhysicalPosition::new(
+                    point.x as f64,
+                    point.y as f64,
+                ),
+            },
+        });
+    }
