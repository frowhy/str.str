+    /// str-gui patch: deliver a `CursorMoved` for the drag's current position,
+    /// converted to client physical coordinates. During an OLE drag session no
+    /// mouse-move events are delivered, so without this the drag cursor position
+    /// never updates and position-dependent drop targets cannot resolve.
+    ///
+    /// The point comes from `GetCursorPos`, **not** from the `pt` argument of the
+    /// OLE callbacks: `pt` is a by-value `POINTL` in the interface definition, so
+    /// reading it through a pointer is not portable, and it is observed to be null
+    /// in practice — which silently turns this whole function into a no-op. The
+    /// drop then resolves at whatever cursor position the window last saw, i.e.
+    /// wherever the pointer was before the drag started. The physical cursor
+    /// position is always readable while a drag is in flight.
+    unsafe fn emit_drag_cursor_moved(this: *mut IDropTarget) {
+        let drop_handler = unsafe { Self::from_interface(this) };
+        let mut point = POINT { x: 0, y: 0 };
+        if unsafe { GetCursorPos(&mut point) } == 0 {
+            return;
+        }
+        if unsafe { ScreenToClient(drop_handler.window, &mut point) } == 0 {
+            return;
+        }
+        if drag_debug() {
+            eprintln!("[str-dnd] CursorMoved client=({}, {})", point.x, point.y);
+        }
+        drop_handler.send_event(Event::WindowEvent {
+            window_id: RootWindowId(WindowId(drop_handler.window)),
+            event: crate::event::WindowEvent::CursorMoved {
+                device_id: super::DEVICE_ID,
+                position: crate::dpi::PhysicalPosition::new(
+                    point.x as f64,
+                    point.y as f64,
+                ),
+            },
+        });
+    }
