+    /// Deliver the current OS-drag cursor position as a `CursorMoved` event.
+    ///
+    /// `sender` is the `NSDraggingInfo` (the target window); `draggingLocation` is
+    /// in window base coordinates (bottom-left origin), which the winit view
+    /// converts to client-area coordinates exactly like `NSView::mouse_motion`.
+    fn emit_drag_cursor_moved(&self, sender: &NSObject) {
+        let location: NSPoint = unsafe { objc2::msg_send![sender, draggingLocation] };
+        let view = self.view();
+        let view_point: NSPoint = view.convertPoint_fromView(location, None);
+        let logical = LogicalPosition::new(view_point.x, view_point.y);
+        self.queue_event(WindowEvent::CursorMoved {
+            device_id: DEVICE_ID,
+            position: logical.to_physical(self.scale_factor()),
+        });
+    }
